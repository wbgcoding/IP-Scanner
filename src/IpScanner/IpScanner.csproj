<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>IP-Scanner</AssemblyName>
    <Version>2.4.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationIcon>Resources\network.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Compress the self-contained single file (~50% smaller, no quality loss). -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IpScanner.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\oui.txt" />
    <Resource Include="Resources\network.ico" />
    <Resource Include="Resources\logo.png" />
  </ItemGroup>
  <!-- The desktop runtime always bundles WinForms, XPS printing and the Ribbon
       alongside WPF. None of them are used here — dropping them shrinks the
       single-file exe considerably. -->
  <Target Name="StripUnusedDesktopAssemblies" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('System.Windows.Forms')) or
                   $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('Microsoft.VisualBasic')) or
                   $([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('WindowsFormsIntegration')) or
                   '%(ResolvedFileToPublish.Filename)' == 'System.Drawing.Common' or
                   '%(ResolvedFileToPublish.Filename)' == 'System.Drawing.Design' or
                   '%(ResolvedFileToPublish.Filename)' == 'System.Windows.Controls.Ribbon' or
                   '%(ResolvedFileToPublish.Filename)' == 'ReachFramework' or
                   '%(ResolvedFileToPublish.Filename)' == 'System.Printing'" />
    </ItemGroup>
  </Target>
</Project>
