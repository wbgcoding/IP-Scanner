<Window x:Class="IpScanner.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IpScanner.Core.Localization"
        Title="{loc:L AppTitle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Surface}" BorderThickness="1"
            CornerRadius="12" Padding="28" MaxWidth="460">
        <StackPanel>
            <TextBlock x:Name="TitleText" Foreground="{DynamicResource Red}" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="CauseText" Foreground="{DynamicResource Text}" FontSize="13" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="380" Margin="0,12,0,0"/>
            <TextBlock x:Name="NextStepText" Foreground="{DynamicResource Subtext}" FontSize="12" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="380" Margin="0,6,0,0"/>
            <Expander x:Name="DetailsExpander" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,14,0,0">
                <Border Background="{DynamicResource BgDark}" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                    <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="DetailsText" Foreground="{DynamicResource Subtext}" FontFamily="Consolas"
                                   FontSize="11" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Expander>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <Button x:Name="OpenLogBtn" Style="{StaticResource GhostButton}" Padding="14,8" Margin="4" Click="OnOpenLog" ToolTip="{loc:L TipErrorOpenLog}"/>
                <Button x:Name="CopyBtn" Style="{StaticResource GhostButton}" Padding="14,8" Margin="4" Click="OnCopy" ToolTip="{loc:L TipErrorCopy}"/>
                <Button x:Name="OkBtn" Style="{StaticResource AccentButton}" Padding="20,8" Margin="4"
                        IsDefault="True" IsCancel="True" Click="OnOk" ToolTip="{loc:L TipDialogOk}"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
