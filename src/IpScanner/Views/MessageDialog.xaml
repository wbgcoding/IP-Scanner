<Window x:Class="IpScanner.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IpScanner.Core.Localization"
        Title="{loc:L AppTitle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="Cycle">
    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Surface}"
            BorderThickness="1" CornerRadius="12" MaxWidth="520" Padding="24">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Left" Width="32" Height="32" VerticalAlignment="Top" Margin="0,0,16,0"
                      FlowDirection="LeftToRight" AutomationProperties.AutomationId="MessageIcon">
                    <Path x:Name="IconFrame" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Fill="Transparent"/>
                    <Path x:Name="IconGlyph" StrokeThickness="2.4" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Grid>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Foreground="{DynamicResource Text}" FontSize="18" FontWeight="Bold"
                               TextWrapping="Wrap" MaxWidth="400"/>
                    <TextBlock x:Name="Body" Foreground="{DynamicResource Text}" FontSize="13"
                               TextWrapping="Wrap" MaxWidth="400" Margin="0,10,0,0"/>
                </StackPanel>
            </DockPanel>
            <StackPanel x:Name="ButtonRow" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="NoBtn" Style="{StaticResource GhostButton}" Padding="18,8" Click="OnNo"/>
                <Button x:Name="YesBtn" Style="{StaticResource AccentButton}" Padding="18,8" Margin="8,0,0,0" Click="OnYes"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
