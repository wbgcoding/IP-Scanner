<Window x:Class="IpScanner.Views.MergeProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IpScanner.Core.Localization"
        Title="{loc:L MergeDb}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" ShowInTaskbar="False"
        AutomationProperties.Name="{loc:L MergeDb}"
        KeyboardNavigation.TabNavigation="Cycle">
    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Surface}"
            BorderThickness="1" CornerRadius="9" Padding="22" MinWidth="360" MaxWidth="520">
        <StackPanel>
            <TextBlock Text="{loc:L MergeDb}" Foreground="{DynamicResource Text}"
                       FontSize="15" FontWeight="Bold"/>
            <ProgressBar x:Name="ProgressBar" Height="10" Margin="0,18,0,8"
                         Minimum="0" Maximum="100" AutomationProperties.Name="{loc:L MergeDb}"/>
            <TextBlock x:Name="RecordsText" Foreground="{DynamicResource Text}"/>
            <TextBlock x:Name="ProgressText" Foreground="{DynamicResource Text}" Margin="0,6,0,0"/>
            <TextBlock x:Name="SizeText" Foreground="{DynamicResource Text}" Margin="0,6,0,0"/>
            <TextBlock x:Name="EtaText" Foreground="{DynamicResource Text}" Margin="0,6,0,0"/>
            <Button x:Name="CancelButton" Content="{loc:L PortCheckCancelButton}"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" Margin="0,18,0,0" Padding="18,8"
                    AutomationProperties.Name="{loc:L PortCheckCancelButton}" Click="OnCancel" ToolTip="{loc:L TipMergeCancel}"/>
        </StackPanel>
    </Border>
</Window>
