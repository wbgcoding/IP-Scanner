<Window x:Class="IpScanner.Views.BackupPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IpScanner.Core.Localization"
        Title="{loc:L BackupPasswordTitle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" ShowInTaskbar="False"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="{loc:L BackupPasswordTitle}">
    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Surface}"
            BorderThickness="1" CornerRadius="12" MaxWidth="520" Padding="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="{loc:L BackupPasswordTitle}" Foreground="{DynamicResource Mauve}"
                       FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="Body" Foreground="{DynamicResource Text}" FontSize="13"
                       TextWrapping="Wrap" MaxWidth="460" Margin="0,14,0,16"/>
            <TextBlock Text="{loc:L BackupPasswordLabel}" Foreground="{DynamicResource Subtext}" FontSize="12"
                       Margin="0,0,0,4"/>
            <PasswordBox x:Name="First" Width="320" HorizontalAlignment="Left"
                         AutomationProperties.Name="{loc:L BackupPasswordLabel}"
                         PasswordChanged="OnPasswordChanged"/>
            <StackPanel x:Name="RepeatPanel" Margin="0,12,0,0">
                <TextBlock Text="{loc:L BackupPasswordRepeat}" Foreground="{DynamicResource Subtext}" FontSize="12"
                           Margin="0,0,0,4"/>
                <PasswordBox x:Name="Second" ToolTip="{loc:L TipBackupPwRepeat}" Width="320" HorizontalAlignment="Left"
                             AutomationProperties.Name="{loc:L BackupPasswordRepeat}"
                             PasswordChanged="OnPasswordChanged"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Red}" FontSize="12" FontWeight="SemiBold"
                       TextWrapping="Wrap" MaxWidth="460" Margin="0,12,0,0" Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{loc:L Cancel}" Style="{StaticResource GhostButton}"
                        Padding="18,8" IsCancel="True" Click="OnCancel" ToolTip="{loc:L TipDialogCancel}"/>
                <Button Content="{loc:L Confirm}" Style="{StaticResource AccentButton}"
                        x:Name="ConfirmBtn" Padding="18,8" Margin="8,0,0,0" IsDefault="True" Click="OnConfirm"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
