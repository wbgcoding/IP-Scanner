<Window x:Class="IpScanner.Views.IntrusiveCheckWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" ShowInTaskbar="False"
        AutomationProperties.Name="{loc:L IntrusiveCheckWarningTitle}"
        xmlns:loc="clr-namespace:IpScanner.Core.Localization"
        Title="{loc:L IntrusiveCheckWarningTitle}"
        KeyboardNavigation.TabNavigation="Cycle">
    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Surface}"
            BorderThickness="1" CornerRadius="12" MaxWidth="520">
        <StackPanel>
            <Border Background="{DynamicResource Red}" CornerRadius="12,12,0,0" Padding="24,16">
                <TextBlock Text="{loc:L IntrusiveCheckWarningTitle}" Foreground="{DynamicResource OnDangerText}"
                           FontSize="18" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>
            <StackPanel Margin="24,20,24,24">
                <TextBlock x:Name="BodyText" Foreground="{DynamicResource Text}"
                           FontSize="13" TextWrapping="Wrap" MaxWidth="440" LineHeight="20"/>
                <TextBlock x:Name="OutsideNote" Text="{loc:L FullPortScanOutsideNote}" Foreground="{DynamicResource Text}"
                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="440" LineHeight="20"
                           Margin="0,10,0,0" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="CancelBtn" Content="{loc:L PortCheckCancelButton}"
                            Style="{StaticResource GhostButton}" Padding="18,8" IsCancel="True"
                            AutomationProperties.Name="{loc:L PortCheckCancelButton}" Click="OnCancel" ToolTip="{loc:L TipDialogCancel}"/>
                    <Button Content="{loc:L IntrusiveCheckWarningConfirm}"
                            Style="{StaticResource DangerButton}" Padding="20,8" Margin="10,0,0,0"
                            IsDefault="True" AutomationProperties.Name="{loc:L IntrusiveCheckWarningConfirm}"
                            Click="OnConfirm" ToolTip="{loc:L TipIntrusiveCheckConfirm}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
