<UserControl x:Class="IpScanner.Views.Tools.CalculatorTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:IpScanner.Core.Localization">
    <!-- Instant blocks stacked on one page: subnet calculator, contains test and subnet split. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Subnet calculator -->
            <TextBlock Text="{loc:L CalcSubnetTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L PortCheckTargetLabel}"/>
                    <TextBox AutomationProperties.Name="{loc:L PortCheckTargetLabel}" MinWidth="140" Text="{Binding SubnetAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:L TipCalcAddress}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L CalcMaskHint}"/>
                    <TextBox Width="140" ToolTip="{loc:L CalcMaskHint}" AutomationProperties.Name="{loc:L CalcMaskHint}"
                             Text="{Binding SubnetMask, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding SubnetError}" Foreground="{DynamicResource Peach}" FontSize="11" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid Margin="0,8,0,0" Grid.IsSharedSizeScope="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSubnetResult}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CalcL"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CalcNetworkLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding NetworkResult}" FontFamily="Consolas"/>
                </Grid>
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CalcR"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding BroadcastLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding BroadcastResult}" FontFamily="Consolas"/>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,4">
<Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIpv6Result}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CalcL"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CalcFirstHostLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding FirstHostResult}" FontFamily="Consolas"/>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
<Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIpv6Result}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CalcR"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CalcLastHostLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding LastHostResult}" FontFamily="Consolas"/>
                </Grid>

                <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CalcL"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding UsableHostsLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding UsableHostsResult}" FontFamily="Consolas"/>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,4">
<Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIpv6Result}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CalcR"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CalcWildcardLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding WildcardResult}" FontFamily="Consolas"/>
                </Grid>

                <Grid Grid.Row="3" Grid.Column="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CalcL"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CalcCidrLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding CidrResult}" FontFamily="Consolas"/>
                </Grid>
            </Grid>

            <StackPanel Margin="0,12,0,0">
                <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L CalcContainsLabel}"/>
                <TextBox HorizontalAlignment="Left" Width="260" AutomationProperties.Name="{loc:L CalcContainsLabel}" ToolTip="{loc:L CalcContainsHint}"
                         Text="{Binding ContainsAddress, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <TextBlock Text="{Binding ContainsResult}" Margin="0,4,0,0" FontFamily="Consolas">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasContainsResult}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Split the network into smaller subnets (IPv4 only) -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSplit}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Height="1" Background="{DynamicResource Surface2}" Margin="0,16,0,14"/>
                <TextBlock Text="{loc:L CalcSplitTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L CalcSplitPrefixLabel}"/>
                <TextBox HorizontalAlignment="Left" Width="140" AutomationProperties.Name="{loc:L CalcSplitPrefixLabel}" ToolTip="{loc:L TipCalcSplitPrefix}"
                         Text="{Binding SplitPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding SplitError}" Foreground="{DynamicResource Peach}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSplitRows}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding SplitSummary}" Foreground="{DynamicResource Subtext}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:L CalcNetworkLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{loc:L CalcFirstHostLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{loc:L CalcLastHostLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{loc:L CalcBroadcastLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="4" Text="{loc:L CalcUsableHostsLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                    </Grid>
                    <ItemsControl x:Name="SplitList" ItemsSource="{Binding SplitRows}" FlowDirection="LeftToRight">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Network}" FontFamily="Consolas" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FirstHost}" FontFamily="Consolas" FontSize="12"/>
                                    <TextBlock Grid.Column="2" Text="{Binding LastHost}" FontFamily="Consolas" FontSize="12"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Broadcast}" FontFamily="Consolas" FontSize="12"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Hosts}" FontFamily="Consolas" FontSize="12" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
