<UserControl x:Class="IpScanner.Views.Tools.CalculatorTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:IpScanner.Core.Localization">
    <!-- Three independent, instant blocks stacked on one page. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Subnet calculator -->
            <TextBlock Text="{loc:L CalcSubnetTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L PortCheckTargetLabel}"/>
                    <TextBox AutomationProperties.Name="{loc:L PortCheckTargetLabel}" MinWidth="140" Text="{Binding SubnetAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:L TipCalcAddress}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L CalcMaskHint}"/>
                    <TextBox Width="140" ToolTip="{loc:L CalcMaskHint}" AutomationProperties.Name="{loc:L CalcMaskHint}"
                             Text="{Binding SubnetMask, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding SubnetError}" Foreground="{DynamicResource Peach}" FontSize="11" Margin="0,4,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Grid Margin="0,8,0,0" Grid.IsSharedSizeScope="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSubnetResult}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CalcL"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CalcNetworkLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding NetworkResult}" FontFamily="Consolas"/>
                </Grid>
                <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CalcR"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding BroadcastLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding BroadcastResult}" FontFamily="Consolas"/>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,4">
<Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIpv6Result}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CalcL"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CalcFirstHostLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding FirstHostResult}" FontFamily="Consolas"/>
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,4">
<Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIpv6Result}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CalcR"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CalcLastHostLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding LastHostResult}" FontFamily="Consolas"/>
                </Grid>

                <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CalcL"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding UsableHostsLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding UsableHostsResult}" FontFamily="Consolas"/>
                </Grid>
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,4">
<Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsIpv6Result}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CalcR"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CalcWildcardLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding WildcardResult}" FontFamily="Consolas"/>
                </Grid>

                <Grid Grid.Row="3" Grid.Column="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CalcL"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CalcCidrLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding CidrResult}" FontFamily="Consolas"/>
                </Grid>
            </Grid>

            <StackPanel Margin="0,12,0,0">
                <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L CalcContainsLabel}"/>
                <TextBox HorizontalAlignment="Left" Width="260" AutomationProperties.Name="{loc:L CalcContainsLabel}" ToolTip="{loc:L CalcContainsHint}"
                         Text="{Binding ContainsAddress, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <TextBlock Text="{Binding ContainsResult}" Margin="0,4,0,0" FontFamily="Consolas">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasContainsResult}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border Height="1" Background="{DynamicResource Surface2}" Margin="0,16,0,14"/>

            <!-- Vendor lookup -->
            <TextBlock Text="{loc:L CalcVendorTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox ToolTip="{loc:L CalcMacHint}" AutomationProperties.Name="{loc:L CalcVendorTitle}" Width="260" HorizontalAlignment="Left"
                     Text="{Binding VendorMac, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Margin="0,6,0,0" FontFamily="Consolas">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasVendorResult}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="{Binding VendorResult, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="{Binding VendorFooter}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,6,0,0"/>

            <Border Height="1" Background="{DynamicResource Surface2}" Margin="0,16,0,14"/>

            <!-- ARP address table lookup -->
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:L CalcArpTitle}" FontWeight="SemiBold"/>
                <TextBlock Text="{loc:L CalcArpLocalOnly}" Foreground="{DynamicResource Subtext}" FontSize="11"
                           VerticalAlignment="Bottom" Margin="8,0,0,1"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBox AutomationProperties.Name="{loc:L CalcArpTitle}" Width="260" Margin="0,0,8,0" Text="{Binding ArpIp, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:L TipCalcArp}"/>
                <Button Content="{loc:L CalcLookupButton}" Click="OnArpLookupClick" ToolTip="{loc:L TipCalcLookup}"
                        Style="{StaticResource ToolAccentButton}" IsEnabled="{Binding CanLookupArp}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasArpResult}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding ArpMac}" FontFamily="Consolas" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding ArpVendor}" Foreground="{DynamicResource Subtext}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
