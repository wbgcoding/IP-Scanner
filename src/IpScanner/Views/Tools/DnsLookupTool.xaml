<UserControl x:Class="IpScanner.Views.Tools.DnsLookupTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:IpScanner.Core.Localization">
    <!-- Shared tool-page layout: input row + action button on top, server and type
         choice, results filling the middle, status line at the bottom. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L DnsTargetLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox ToolTip="{loc:L DnsTargetHint}" AutomationProperties.Name="{loc:L DnsTargetLabel}" MinWidth="160"
                         Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>

                <Button Grid.Column="1" Content="{loc:L DnsStartButton}" Click="OnStartClick" ToolTip="{loc:L TipDnsStart}"
                        Style="{StaticResource ToolAccentButton}" IsEnabled="{Binding CanStart}"/>
            </Grid>
        </StackPanel>

        <!-- Server (or the compare list) and record type -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,8,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CompareMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L DnsServerLabel}"/>
                <ComboBox IsEditable="True" ItemsSource="{Binding ServerChoices}" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="{loc:L DnsServerLabel}" ToolTip="{loc:L TipDnsServer}"/>
            </StackPanel>

            <StackPanel Margin="0,0,8,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CompareMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L DnsCompareServersLabel}"/>
                <ItemsControl ItemsSource="{Binding CompareServers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface2}" CornerRadius="4" Padding="8,0,2,0" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Content="✕" Tag="{Binding}" Click="OnRemoveServerClick" Style="{StaticResource ToolGhostButton}"
                                            Height="26" MinWidth="0" Padding="8,0" Margin="4,0,0,0"
                                            AutomationProperties.Name="{loc:L DnsRemoveServerButton}" ToolTip="{loc:L TipDnsCompareRemove}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewServerBox" Text="{Binding NewServer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                             AutomationProperties.Name="{loc:L DnsServerLabel}" ToolTip="{loc:L TipDnsCompareNew}" KeyDown="OnNewServerKeyDown"/>
                    <Button Grid.Column="1" Content="{loc:L DnsAddServerButton}" Click="OnAddServerClick"
                            Style="{StaticResource ToolGhostButton}" ToolTip="{loc:L TipDnsCompareAdd}"/>
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L DnsTypeLabel}"/>
                <ComboBox ItemsSource="{Binding TypeOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedType}"
                          AutomationProperties.Name="{loc:L DnsTypeLabel}" ToolTip="{loc:L TipDnsType}"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding ServerError}" Foreground="{DynamicResource Peach}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasServerError}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UsesSystemResolver}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <RadioButton Content="{loc:L DnsModeAuto}" ToolTip="{loc:L TipDnsAuto}" GroupName="DnsMode" IsChecked="True"
                             Checked="OnModeChanged" Margin="0,0,14,0" Tag="Auto"/>
                <RadioButton Content="{loc:L DnsModeForward}" ToolTip="{loc:L TipDnsForward}" GroupName="DnsMode" Checked="OnModeChanged" Margin="0,0,14,0" Tag="Forward"/>
                <RadioButton Content="{loc:L DnsModeReverse}" ToolTip="{loc:L TipDnsReverse}" GroupName="DnsMode" Checked="OnModeChanged" Margin="0,0,14,0" Tag="Reverse"/>
            </StackPanel>
            <CheckBox Content="{loc:L DnsCompareToggle}" ToolTip="{loc:L TipDnsCompare}" IsChecked="{Binding CompareMode}"/>
        </WrapPanel>

        <ScrollViewer Grid.Row="4" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowForwardResults}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L DnsAddressesLabel}"/>
                    <ItemsControl ItemsSource="{Binding Addresses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" Margin="0,0,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Margin="0,10,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowReverseResults}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L DnsCanonicalLabel}"/>
                    <TextBlock Text="{Binding CanonicalName}" FontFamily="Consolas" Margin="0,0,0,8"/>
                    <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L DnsAliasesLabel}"/>
                    <ItemsControl ItemsSource="{Binding Aliases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" Margin="0,0,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Records answered by a chosen server -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowRecordResults}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid Margin="0,0,0,4" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:L DnsTypeLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{loc:L DnsCanonicalLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{loc:L DnsColValue}" Foreground="{DynamicResource Subtext}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{loc:L DnsColTtl}" Foreground="{DynamicResource Subtext}" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Records}" FlowDirection="LeftToRight">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Type}" FontFamily="Consolas" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Ttl}" FontFamily="Consolas" FontSize="12" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Same question to several servers -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowCompareResults}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Grid Margin="9,0,9,4" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:L DnsServerLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{loc:L DnsColTime}" Foreground="{DynamicResource Subtext}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{loc:L DnsColCode}" Foreground="{DynamicResource Subtext}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{loc:L DnsColAnswers}" Foreground="{DynamicResource Subtext}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding CompareRows}" FlowDirection="LeftToRight">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,4" Padding="8,4" CornerRadius="4" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Surface}"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="ToolTip" Value="{Binding Tip}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFastest}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Green}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Peach}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Server}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Time}" FontFamily="Consolas" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFastest}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Green}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Code}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Answers}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Peach}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Margin="0,16,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CompareMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L DnsServersLabel}"/>
                    <ItemsControl ItemsSource="{Binding DnsServers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" Margin="0,0,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Text}" FontSize="12" VerticalAlignment="Center"/>
            <Button Content="{loc:L DnsCopyButton}" Style="{StaticResource ToolGhostButton}"
                    Margin="14,0,0,0" Click="OnCopyClick" ToolTip="{loc:L TipDnsCopy}"/>
        </StackPanel>
    </Grid>
</UserControl>
