<UserControl x:Class="IpScanner.Views.Tools.CertificateTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:IpScanner.Core.Localization">
    <!-- Target+port on top, result block filling the middle, status at the bottom. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L PortCheckTargetLabel}"/>
                <TextBox AutomationProperties.Name="{loc:L PortCheckTargetLabel}" MinWidth="160" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:L TipCertTarget}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Style="{StaticResource ToolCaption}" Text="{loc:L Port}"/>
                <TextBox AutomationProperties.Name="{loc:L Port}" Width="80" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:L TipCertPort}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource ToolCaption}" Text=" "/>
                <Grid>
                    <Button Content="{loc:L PingStartButton}" Click="OnStartClick" ToolTip="{loc:L TipCertStart}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolAccentButton}">
                                <Setter Property="IsEnabled" Value="{Binding CanStart}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{loc:L WakeStopButton}" Click="OnStopClick" ToolTip="{loc:L TipStopRun}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolDangerButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasResult}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Grid.IsSharedSizeScope="True">
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CertLbl"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CertSubjectLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Subject}" FontFamily="Consolas"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CertLbl"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CertIssuerLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Issuer}" FontFamily="Consolas"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CertLbl"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CertValidFromLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding ValidFrom}" FontFamily="Consolas" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="2" Text="{loc:L CertValidToLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding ValidTo}" FontFamily="Consolas"/>
                </Grid>
                <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CertLbl"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding DaysRemainingText}" Grid.Column="1" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DaysRemainingColorKey}" Value="Red">
                                    <Setter Property="Foreground" Value="{DynamicResource Red}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DaysRemainingColorKey}" Value="Peach">
                                    <Setter Property="Foreground" Value="{DynamicResource Peach}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock></Grid>

                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CertLbl"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CertSigAlgLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding SignatureAlgorithm}" FontFamily="Consolas" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="2" Text="{loc:L CertKeySizeLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding KeySize}" FontFamily="Consolas"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CertLbl"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:L CertFingerprintLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Fingerprint}" FontFamily="Consolas" TextWrapping="Wrap"/>
                </Grid>

                <TextBlock Text="{loc:L CertSanLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,8,0,4"/>
                <ItemsControl ItemsSource="{Binding SubjectAlternativeNames}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" Margin="0,0,0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{loc:L CertChainLabel}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,8,0,4"/>
                <ItemsControl ItemsSource="{Binding ChainFindings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,0,0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource Peach}" FontSize="12" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
