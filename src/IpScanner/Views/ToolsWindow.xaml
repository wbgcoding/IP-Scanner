<Window x:Class="IpScanner.Views.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IpScanner.Core.Localization"
        Title="{loc:L Tools}" Height="620" Width="900" MinWidth="820" MinHeight="560"
        Icon="/Resources/network.ico" Background="{DynamicResource Bg}"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="OnWindowKeyDown" StateChanged="OnWindowStateChanged">
    <Window.Resources>
        <!-- Every single-line input and button on the tool pages is 32 high, so inputs that sit next to or
             below each other line up. Multi-line boxes keep their own height. -->
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="7,0"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="32"/>
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar, same pattern as MainWindow. -->
        <Border Grid.Row="0" Background="{DynamicResource BgDark}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="/Resources/logo.png" Width="16" Height="16" Margin="10,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{loc:L Tools}" Foreground="{DynamicResource Subtext}"
                           FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" FlowDirection="LeftToRight"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                            Click="OnMinimizeClick" AutomationProperties.Name="{loc:L Minimize}">
                        <Viewbox Width="11" Height="11">
                            <Path Fill="{DynamicResource Text}" Data="M20,14H4V10H20Z"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButton}"
                            Click="OnMaximizeRestoreClick" AutomationProperties.Name="{loc:L Maximize}">
                        <Viewbox Width="11" Height="11">
                            <Path x:Name="MaximizeRestoreGlyph" Fill="{DynamicResource Text}" Data="M4,4H20V20H4V4M6,6V18H18V6H6Z"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}"
                            Click="OnCloseClick" AutomationProperties.Name="{loc:L Close}">
                        <Path Width="8" Height="8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource Text}" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left tool list + right work area. At a large text size on a small screen the window cannot
             grow to its scaled minimum, so the area keeps that minimum and scrolls instead of clipping.
             It fills the viewport otherwise, so the pages' star rows still stretch. -->
        <ScrollViewer x:Name="ToolsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Focusable="False">
        <DockPanel MinWidth="820" MinHeight="524"
                   Width="{Binding ViewportWidth, ElementName=ToolsScroll}"
                   Height="{Binding ViewportHeight, ElementName=ToolsScroll}">
            <ListBox x:Name="ToolsNavList" ToolTip="{loc:L TipToolsNav}" DockPanel.Dock="Left" Width="180" Margin="10,10,4,10"
                     Style="{StaticResource SettingsNavList}" ItemContainerStyle="{StaticResource SettingsNavItem}"
                     SelectionChanged="OnToolsNavChanged">
                <ListBoxItem Tag="WakeOnLan" AutomationProperties.Name="{loc:L ToolWakeOnLan}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0" FlowDirection="LeftToRight">
                            <Path Fill="{DynamicResource Text}" Data="M7,2V13H10V22L17,10H13L17,2H7Z"/>
                        </Viewbox>
                        <TextBlock Text="{loc:L ToolWakeOnLan}" Style="{StaticResource SettingsNavLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="PortCheck" AutomationProperties.Name="{loc:L ToolPortCheck}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0" FlowDirection="LeftToRight">
                            <Path Fill="{DynamicResource Text}" Data="M16,7V3H14V7H10V3H8V7H8C8,9.05 9.23,10.79 11,11.55V16A2,2 0 0,0 13,18V22H15V18A2,2 0 0,0 17,16V11.55C18.77,10.79 20,9.05 20,7H16Z"/>
                        </Viewbox>
                        <TextBlock Text="{loc:L ToolPortCheck}" Style="{StaticResource SettingsNavLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="DnsLookup" AutomationProperties.Name="{loc:L ToolDnsLookup}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0" FlowDirection="LeftToRight">
                            <Path Fill="{DynamicResource Text}" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>
                        </Viewbox>
                        <TextBlock Text="{loc:L ToolDnsLookup}" Style="{StaticResource SettingsNavLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="PingRoute" AutomationProperties.Name="{loc:L ToolPingRoute}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0" FlowDirection="LeftToRight">
                            <Path Fill="{DynamicResource Text}" Data="M16,11.78L20.24,4.45L21.97,5.45L16.74,14.5L10.23,10.75L5.46,19H22V21H2V3H4V17.54L9.5,8L16,11.78Z"/>
                        </Viewbox>
                        <TextBlock Text="{loc:L ToolPingRoute}" Style="{StaticResource SettingsNavLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Calculator" AutomationProperties.Name="{loc:L ToolCalculator}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0" FlowDirection="LeftToRight">
                            <Path Fill="{DynamicResource Text}" Data="M7,2H17A2,2 0 0,1 19,4V20A2,2 0 0,1 17,22H7A2,2 0 0,1 5,20V4A2,2 0 0,1 7,2M7,4V8H17V4H7M7,10V12H9V10H7M11,10V12H13V10H11M15,10V12H17V10H15M7,14V16H9V14H7M11,14V16H13V14H11M15,14V16H17V14H15M7,18V20H9V18H7M11,18V20H13V18H11M15,18V20H17V18H15Z"/>
                        </Viewbox>
                        <TextBlock Text="{loc:L ToolCalculator}" Style="{StaticResource SettingsNavLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="MacTool" AutomationProperties.Name="{loc:L ToolMacTool}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0" FlowDirection="LeftToRight">
                            <Path Fill="{DynamicResource Text}" Data="M4,5H20A2,2 0 0,1 22,7V15A2,2 0 0,1 20,17H15V19H9V17H4A2,2 0 0,1 2,15V7A2,2 0 0,1 4,5M4,7V15H20V7H18V11H16V7H14V11H12V7H10V11H8V7H6V11H4V7Z"/>
                        </Viewbox>
                        <TextBlock Text="{loc:L ToolMacTool}" Style="{StaticResource SettingsNavLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Certificate" AutomationProperties.Name="{loc:L ToolCertificate}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0" FlowDirection="LeftToRight">
                            <Path Fill="{DynamicResource Text}" Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z"/>
                        </Viewbox>
                        <TextBlock Text="{loc:L ToolCertificate}" Style="{StaticResource SettingsNavLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="HostDiscovery" AutomationProperties.Name="{loc:L ToolHostDiscovery}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0" FlowDirection="LeftToRight">
                            <Path Fill="{DynamicResource Text}" Data="M12,3A9,9 0 1,0 21,12A9,9 0 0,0 12,3M12,5A7,7 0 0,1 19,12H17A5,5 0 0,0 12,7V5M12,9A3,3 0 0,1 15,12H13A1,1 0 0,0 12,11V9M12,13A1,1 0 1,1 12,15A1,1 0 0,1 12,13Z"/>
                        </Viewbox>
                        <TextBlock Text="{loc:L ToolHostDiscovery}" Style="{StaticResource SettingsNavLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="ServiceDetection" AutomationProperties.Name="{loc:L ToolServiceDetection}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0" FlowDirection="LeftToRight">
                            <Path Fill="{DynamicResource Text}" Data="M4,4H20V8H4V4M4,10H20V14H4V10M4,16H20V20H4V16M6,5.5V6.5H8V5.5H6M6,11.5V12.5H8V11.5H6M6,17.5V18.5H8V17.5H6Z"/>
                        </Viewbox>
                        <TextBlock Text="{loc:L ToolServiceDetection}" Style="{StaticResource SettingsNavLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="OsEstimate" AutomationProperties.Name="{loc:L ToolOsEstimate}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0" FlowDirection="LeftToRight">
                            <Path Fill="{DynamicResource Text}" Data="M4,4H20A2,2 0 0,1 22,6V16A2,2 0 0,1 20,18H14V20H16V22H8V20H10V18H4A2,2 0 0,1 2,16V6A2,2 0 0,1 4,4M4,6V16H20V6H4Z"/>
                        </Viewbox>
                        <TextBlock Text="{loc:L ToolOsEstimate}" Style="{StaticResource SettingsNavLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="Checks" AutomationProperties.Name="{loc:L ToolChecks}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0" FlowDirection="LeftToRight">
                            <Path Fill="{DynamicResource Text}" Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,7A2,2 0 0,1 14,9V10H15V15H9V10H10V9A2,2 0 0,1 12,7M12,8.5A0.5,0.5 0 0,0 11.5,9V10H12.5V9A0.5,0.5 0 0,0 12,8.5Z"/>
                        </Viewbox>
                        <TextBlock Text="{loc:L ToolChecks}" Style="{StaticResource SettingsNavLabel}"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="ScanExport" AutomationProperties.Name="{loc:L ToolScanExport}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0" FlowDirection="LeftToRight">
                            <Path Fill="{DynamicResource Text}" Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13,9V3.5L18.5,9H13M12,11L16,15H13V19H11V15H8L12,11Z"/>
                        </Viewbox>
                        <TextBlock Text="{loc:L ToolScanExport}" Style="{StaticResource SettingsNavLabel}"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
            <Border DockPanel.Dock="Left" Width="1" Background="{DynamicResource Surface}" Margin="0,10"/>
            <DockPanel Margin="16">
            <TextBlock x:Name="ToolDescription" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource Subtext}" Margin="0,0,0,12"/>
            <ContentControl x:Name="ToolContent"/>
        </DockPanel>
        </DockPanel>
        </ScrollViewer>
    </Grid>
</Window>
