<Window x:Class="IpScanner.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:IpScanner.Core.Localization"
        Title="{loc:L UpdateTitle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Surface}" BorderThickness="1"
            CornerRadius="12" Padding="28" MaxWidth="440">
        <StackPanel>
            <Image Source="pack://application:,,,/Resources/logo.png" Width="44" Height="44"
                   HorizontalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Foreground="{DynamicResource Mauve}" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock x:Name="BodyText" Foreground="{DynamicResource Subtext}" FontSize="13" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="360" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <Button x:Name="LaterBtn" Style="{StaticResource GhostButton}" Padding="18,8" IsCancel="True" Click="OnLater" ToolTip="{loc:L TipUpdateLater}"/>
                <Button x:Name="UpdateBtn" Style="{StaticResource AccentButton}" Padding="20,8" Margin="10,0,0,0" IsDefault="True" Click="OnUpdate" ToolTip="{loc:L TipUpdateNow}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
