<UserControl x:Class="IpScanner.Views.ArchivePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:IpScanner.Core.Localization"
             Background="{DynamicResource Bg}"
             KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.Name="{loc:L ArchiveTitle}">
    <UserControl.Resources>
        <!-- Own template: the stock one draws a bitmap-like "15" calendar button that fits neither theme.
             Same frame as the app's text boxes, with a line-drawn calendar glyph as the drop-down button. -->
        <Style TargetType="DatePicker">
            <!-- The picker binds its calendar's Style to this property, which hides any implicit Calendar style. -->
            <Setter Property="CalendarStyle" Value="{DynamicResource ThemedCalendar}"/>
            <Setter Property="Background" Value="{DynamicResource BgAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="IsTodayHighlighted" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid x:Name="PART_Root">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox" Padding="7,5" Background="Transparent"
                                                   Foreground="{TemplateBinding Foreground}"/>
                                <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" Cursor="Hand"
                                        Margin="0,0,4,0" Padding="5,4" Background="Transparent">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bb" CornerRadius="5" Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <Path x:Name="glyph" Width="16" Height="16" Stretch="None" FlowDirection="LeftToRight"
                                                      Stroke="{DynamicResource Subtext}" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M 3.5,4 H 12.5 A 1.5,1.5 0 0 1 14,5.5 V 12.5 A 1.5,1.5 0 0 1 12.5,14 H 3.5 A 1.5,1.5 0 0 1 2,12.5 V 5.5 A 1.5,1.5 0 0 1 3.5,4 Z M 2,7.5 H 14 M 5.5,2 V 5 M 10.5,2 V 5 M 5,10.5 H 6 M 7.5,10.5 H 8.5 M 10,10.5 H 11"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bb" Property="Background" Value="{DynamicResource Surface}"/>
                                                    <Setter TargetName="glyph" Property="Stroke" Value="{DynamicResource Mauve}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Popup x:Name="PART_Popup" AllowsTransparency="True" StaysOpen="False"
                                       Placement="Bottom" PlacementTarget="{Binding ElementName=PART_TextBox}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Mauve}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Surface2}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Grid Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            <TextBlock x:Name="Hint" Text="{loc:L PickDate}" Foreground="{DynamicResource Subtext}"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The stock calendar draws a white face with fixed dark glyphs, unreadable next to the themed picker. -->
        <ControlTemplate x:Key="CalendarNavButton" TargetType="Button">
            <Border x:Name="nb" CornerRadius="5" Background="Transparent" Padding="8,6">
                <Path x:Name="arrow" Width="10" Height="10" Stretch="None" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                      Stroke="{DynamicResource Subtext}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="nb" Property="Background" Value="{DynamicResource Surface}"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="{DynamicResource Mauve}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="arrow" Property="Opacity" Value="0.35"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="CalendarDayStyle" TargetType="CalendarDayButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarDayButton">
                        <Border x:Name="db" Width="32" Height="28" Margin="1" CornerRadius="5"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <TextBlock x:Name="tx" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource Subtext}"/>
                                <Setter TargetName="db" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsToday" Value="True">
                                <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource Mauve}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="db" Property="Background" Value="{DynamicResource Surface}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="db" Property="BorderBrush" Value="{DynamicResource Mauve}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="db" Property="Background" Value="{DynamicResource Mauve}"/>
                                <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource Bg}"/>
                                <Setter TargetName="db" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsBlackedOut" Value="True">
                                <Setter TargetName="db" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CalendarMonthStyle" TargetType="CalendarButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarButton">
                        <Border x:Name="mb" Width="54" Height="40" Margin="2" CornerRadius="5"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <TextBlock x:Name="tx" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{DynamicResource Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsInactive" Value="True">
                                <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource Subtext}"/>
                                <Setter TargetName="mb" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="mb" Property="Background" Value="{DynamicResource Surface}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="mb" Property="BorderBrush" Value="{DynamicResource Mauve}"/>
                            </Trigger>
                            <!-- The year view flags the shown month this way; outline it like today. -->
                            <Trigger Property="HasSelectedDays" Value="True">
                                <Setter TargetName="mb" Property="BorderBrush" Value="{DynamicResource Mauve}"/>
                                <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource Mauve}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CalendarItemThemed" TargetType="CalendarItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarItem">
                        <ControlTemplate.Resources>
                            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                <TextBlock Text="{Binding}" Margin="0,2,0,4" HorizontalAlignment="Center"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Subtext}"/>
                            </DataTemplate>
                        </ControlTemplate.Resources>
                        <Grid x:Name="PART_Root" Margin="0,4,0,0">
                            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Surface2}"
                                    BorderThickness="1" CornerRadius="8" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PART_PreviousButton" Focusable="False" Cursor="Hand"
                                            Template="{StaticResource CalendarNavButton}" Tag="M 6.5,1.5 L 3,5 L 6.5,8.5"/>
                                    <Button x:Name="PART_HeaderButton" Grid.Column="1" Focusable="False" Cursor="Hand"
                                            HorizontalAlignment="Center" FontWeight="SemiBold">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="hb" CornerRadius="5" Background="Transparent" Padding="10,4">
                                                    <TextBlock x:Name="ht" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                                               Foreground="{DynamicResource Text}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="hb" Property="Background" Value="{DynamicResource Surface}"/>
                                                        <Setter TargetName="ht" Property="Foreground" Value="{DynamicResource Mauve}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ht" Property="Opacity" Value="0.6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="PART_NextButton" Grid.Column="2" Focusable="False" Cursor="Hand"
                                            Template="{StaticResource CalendarNavButton}" Tag="M 3.5,1.5 L 7,5 L 3.5,8.5"/>
                                    <Grid x:Name="PART_MonthView" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                          HorizontalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                    <Grid x:Name="PART_YearView" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,6,0,0"
                                          HorizontalAlignment="Center" Visibility="Hidden">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Rectangle x:Name="PART_DisabledVisual" Fill="{DynamicResource Bg}" Opacity="0.6"
                                       RadiusX="8" RadiusY="8" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Year">
                                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}" Value="Decade">
                                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemedCalendar" TargetType="Calendar">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="CalendarItemStyle" Value="{StaticResource CalendarItemThemed}"/>
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarDayStyle}"/>
            <Setter Property="CalendarButtonStyle" Value="{StaticResource CalendarMonthStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Calendar">
                        <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
                            <CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- One button look for the whole page: ghost, same padding and font size. -->
        <Style x:Key="ArchiveButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ArchiveSmallButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ArchiveTab" TargetType="ToggleButton" BasedOn="{StaticResource PillToggle}">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="ArchiveGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="ArchiveFrame" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource Bg}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="ArchiveSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ArchiveHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Subtext}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="16,40,16,16"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="ArchiveCenterCell" TargetType="TextBlock" BasedOn="{StaticResource TrimmedCell}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <!-- A multi-subnet run shows its first network plus a count; the tooltip lists them all. -->
        <Style x:Key="RunNetworkCell" TargetType="TextBlock" BasedOn="{StaticResource TrimmedCell}">
            <Setter Property="ToolTip" Value="{Binding NetworkFull}"/>
        </Style>
        <Style x:Key="ChangeTypeCell" TargetType="TextBlock" BasedOn="{StaticResource TrimmedCell}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="New"><Setter Property="Foreground" Value="{DynamicResource Green}"/></DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="Gone"><Setter Property="Foreground" Value="{DynamicResource Red}"/></DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="IpChanged"><Setter Property="Foreground" Value="{DynamicResource Blue}"/></DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="MacChanged"><Setter Property="Foreground" Value="{DynamicResource Mauve}"/></DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="PortsOpened"><Setter Property="Foreground" Value="{DynamicResource Peach}"/></DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="PortsClosed"><Setter Property="Foreground" Value="{DynamicResource Teal}"/></DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="LatencyChanged"><Setter Property="Foreground" Value="{DynamicResource Yellow}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Cards: one rounded surface look for the key figures, the run facts, the chart and the housekeeping row. -->
        <Style x:Key="ArchiveCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="ArchiveCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Subtext}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- A key figure takes the colour of its health state when the page sets one, else the normal text colour. -->
        <Style x:Key="KpiValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAccent}" Value="True">
                    <Setter Property="Foreground" Value="{Binding Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="KpiTemplate">
            <Border Style="{StaticResource ArchiveCard}" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource ArchiveCaption}"/>
                    <TextBlock Text="{Binding Value}" FontSize="{Binding ValueSize}" Style="{StaticResource KpiValue}"/>
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource ArchiveCaption}"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="FactTemplate">
            <StackPanel Margin="0,0,24,6" MinWidth="110" MaxWidth="280">
                <TextBlock Text="{Binding Label}" Style="{StaticResource ArchiveCaption}"/>
                <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                           TextWrapping="Wrap" Margin="0,1,0,0"/>
            </StackPanel>
        </DataTemplate>
        <!-- Number cells sit on the right so the digits line up; latency and loss take the main table's heat colours. -->
        <Style x:Key="ArchiveNumberCell" TargetType="TextBlock" BasedOn="{StaticResource TrimmedCell}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
        </Style>
        <Style x:Key="ArchiveHeatCell" TargetType="TextBlock" BasedOn="{StaticResource ArchiveNumberCell}">
            <Setter Property="Foreground" Value="{Binding LatencyBrush}"/>
        </Style>
        <Style x:Key="ArchiveLossCell" TargetType="TextBlock" BasedOn="{StaticResource ArchiveNumberCell}">
            <Setter Property="Foreground" Value="{Binding LossBrush}"/>
        </Style>
        <Style x:Key="ArchiveSearchHintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Subtext}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="9,0,9,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="20,16" SizeChanged="OnPageSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title row: the run summary or the last message sits under the title; page actions on the right. -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{loc:L ArchiveTitle}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Mauve}"/>
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource Subtext}" FontSize="12" Margin="0,4,12,0"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
            <Button x:Name="CompareButton" Grid.Column="1" VerticalAlignment="Top" ToolTip="{loc:L TipCompareToggle}" Content="{loc:L CompareButton}"
                    Style="{StaticResource ArchiveButton}" Click="OnToggleCompare"/>
            <Button x:Name="StartScanButton" Grid.Column="2" VerticalAlignment="Top" ToolTip="{loc:L TipArchiveStartScan}" Content="{loc:L Scan}"
                    Style="{StaticResource AccentButton}" Padding="14,6" FontSize="13" Margin="0,0,8,0" Visibility="Collapsed" Click="OnStartScan"/>
            <Button Grid.Column="3" VerticalAlignment="Top" Content="{loc:L Close}" Style="{StaticResource ArchiveButton}" Margin="0"
                    Click="OnClose" IsCancel="True" ToolTip="{loc:L TipBackToTable}" AutomationProperties.Name="{loc:L Close}"/>
        </Grid>

        <!-- The overview and the comparison share this cell; the overview scrolls as a whole when the window is small. -->
        <Grid x:Name="ContentHost" Grid.Row="1" SizeChanged="OnHostSizeChanged">
            <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <StackPanel x:Name="TopBlock" SizeChanged="OnHostSizeChanged">
                        <!-- Range: two dates, quick spans and a filter for the device tables. A pick applies at once. -->
                        <WrapPanel x:Name="FilterBar" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                <TextBlock Text="{loc:L ArchiveFrom}" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="FromDate" ToolTip="{loc:L TipArchiveFrom}" MinWidth="140" SelectedDateChanged="OnDateChanged"
                                            AutomationProperties.Name="{loc:L ArchiveFrom}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                                <TextBlock Text="{loc:L ArchiveTo}" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <DatePicker x:Name="ToDate" ToolTip="{loc:L TipArchiveTo}" MinWidth="140" SelectedDateChanged="OnDateChanged"
                                            AutomationProperties.Name="{loc:L ArchiveTo}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,6">
                                <ToggleButton x:Name="QuickDay" Tag="Day" ToolTip="{loc:L TipArchiveRangeDay}" Style="{StaticResource ArchiveTab}" Margin="0,0,6,0" Content="{loc:L RangeDay}" Click="OnQuickRange"
                                              AutomationProperties.Name="{loc:L RangeDay}"/>
                                <ToggleButton x:Name="QuickWeek" Tag="Week" ToolTip="{loc:L TipArchiveRangeWeek}" Style="{StaticResource ArchiveTab}" Margin="0,0,6,0" Content="{loc:L RangeWeek}" Click="OnQuickRange"
                                              AutomationProperties.Name="{loc:L RangeWeek}"/>
                                <ToggleButton x:Name="QuickMonth" Tag="Month" ToolTip="{loc:L TipArchiveRangeMonth}" Style="{StaticResource ArchiveTab}" Margin="0,0,6,0" Content="{loc:L ArchiveRange30d}" Click="OnQuickRange"
                                              AutomationProperties.Name="{loc:L ArchiveRange30d}"/>
                                <ToggleButton x:Name="QuickAll" Tag="All" ToolTip="{loc:L TipArchiveRangeAll}" Style="{StaticResource ArchiveTab}" Margin="0" Content="{loc:L ArchiveClearRange}" IsChecked="True" Click="OnQuickRange"
                                              AutomationProperties.Name="{loc:L ArchiveClearRange}"/>
                            </StackPanel>
                            <Grid Width="230" Margin="0,0,0,6">
                                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" TextChanged="OnSearchChanged" ToolTip="{loc:L ArchiveSearchHint}"
                                         AutomationProperties.Name="{loc:L ArchiveSearchHint}"/>
                                <TextBlock Text="{loc:L ArchiveSearchHint}" Style="{StaticResource ArchiveSearchHintText}"/>
                            </Grid>
                        </WrapPanel>

                        <!-- Key figures of the range. -->
                        <ItemsControl x:Name="KpiList" Margin="0,0,-8,0" Focusable="False" Tag="5" ItemTemplate="{StaticResource KpiTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Devices online per run. -->
                        <Border x:Name="ChartCard" Style="{StaticResource ArchiveCard}" Margin="0,0,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="{loc:L ArchiveChartTitle}" Style="{StaticResource ArchiveCaption}"/>
                                    <TextBlock x:Name="ChartMaxText" Style="{StaticResource ArchiveCaption}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Canvas x:Name="ChartCanvas" Height="56" ClipToBounds="True" SizeChanged="OnChartSizeChanged"
                                        AutomationProperties.Name="{loc:L ArchiveChartTitle}">
                                    <Polygon x:Name="ChartFill" Fill="{DynamicResource Mauve}" Opacity="0.18"/>
                                    <Polyline x:Name="ChartLine" Stroke="{DynamicResource Mauve}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                </Canvas>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ChartTickFirst" Style="{StaticResource ArchiveCaption}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="ChartTickMid" Grid.Column="1" Style="{StaticResource ArchiveCaption}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="ChartTickLast" Grid.Column="2" Style="{StaticResource ArchiveCaption}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Runs on the left, the selected run on the right; stacked below each other on narrow pages. -->
                    <Grid x:Name="MainArea" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="RunsColumn" Width="11*" MinWidth="260"/><ColumnDefinition Width="12"/><ColumnDefinition x:Name="DetailColumn" Width="9*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>

                        <Grid x:Name="RunsPane">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8" MinHeight="30">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:L ArchiveRuns}" Style="{StaticResource ArchiveSectionTitle}" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="DeleteRunButton" ToolTip="{loc:L TipArchiveDeleteRun}" Content="{loc:L ArchiveDeleteRun}" Style="{StaticResource ArchiveSmallButton}"
                                            IsEnabled="False" Click="OnDeleteRun"/>
                                    <Button x:Name="DeleteRangeButton" ToolTip="{loc:L TipArchiveDeleteRange}" Content="{loc:L ArchiveDeleteRange}" Style="{StaticResource ArchiveSmallButton}"
                                            IsEnabled="False" Click="OnDeleteRange"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Style="{StaticResource ArchiveFrame}">
                                <Grid>
                                    <DataGrid x:Name="RunsGrid" Style="{StaticResource ArchiveGrid}" SelectionChanged="OnRunSelected" PreviewMouseWheel="OnGridWheel"
                                              AutomationProperties.Name="{loc:L ArchiveRuns}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L ArchiveDate}" Binding="{Binding DateText}" SortMemberPath="Started" Width="Auto"/>
                                            <DataGridTextColumn x:Name="RunDurationColumn" ElementStyle="{StaticResource ArchiveNumberCell}" Header="{loc:L ArchiveDuration}" Binding="{Binding DurationClock}" SortMemberPath="DurationSeconds" Width="Auto"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource RunNetworkCell}" Header="{loc:L Network}" Binding="{Binding NetworkText}" SortMemberPath="Network" Width="Auto" MaxWidth="170"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource ArchiveNumberCell}" Header="{loc:L Devices}" Binding="{Binding DeviceCount}" Width="Auto"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource ArchiveNumberCell}" Header="{loc:L Online}" Binding="{Binding OnlineCount}" Width="Auto"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource ArchiveHeatCell}" Header="{loc:L ArchiveColAvgMs}" Binding="{Binding AvgText}" SortMemberPath="AvgSort" Width="Auto"/>
                                            <DataGridTextColumn x:Name="RunLossColumn" ElementStyle="{StaticResource ArchiveLossCell}" Header="{loc:L Loss}" Binding="{Binding LossText}" SortMemberPath="LossSort" Width="Auto"/>
                                            <DataGridTextColumn x:Name="RunFindingsColumn" ElementStyle="{StaticResource ArchiveNumberCell}" Header="{loc:L ArchiveKpiFindings}" Binding="{Binding FindingsText}" SortMemberPath="Findings" Width="Auto"/>
                                            <DataGridTextColumn ElementStyle="{StaticResource ArchiveCenterCell}" Header="{loc:L Status}" Binding="{Binding StatusText}" Width="*" MinWidth="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="RunsHint" Style="{StaticResource ArchiveHint}"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <GridSplitter x:Name="MainSplitter" Grid.Column="1" Width="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Background="Transparent" ShowsPreview="False" ResizeBehavior="PreviousAndNext" Focusable="False"/>

                        <Grid x:Name="DetailPane" Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock x:Name="DetailText" Foreground="{DynamicResource Subtext}" FontSize="12" TextWrapping="Wrap" MinHeight="30"
                                       VerticalAlignment="Center" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
                            <Border x:Name="RunCard" Grid.Row="1" Style="{StaticResource ArchiveCard}" Margin="0,0,0,8" Padding="12,10,12,4" Visibility="Collapsed">
                                <ItemsControl x:Name="FactsList" Focusable="False" ItemTemplate="{StaticResource FactTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Border>
                            <TabControl x:Name="DetailTabs" Grid.Row="2" SelectedIndex="0">
                                <TabItem Header="{loc:L Devices}" ToolTip="{loc:L ArchiveDevices}" AutomationProperties.Name="{loc:L ArchiveDevices}">
                                    <Grid>
                                        <DataGrid x:Name="DevicesGrid" Style="{StaticResource ArchiveGrid}" SelectionChanged="OnDeviceSelected" PreviewMouseWheel="OnGridWheel"
                                                  AutomationProperties.Name="{loc:L ArchiveDevices}">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="" Width="28" SortMemberPath="OnlineSort" CanUserResize="False">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Ellipse Width="9" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     Fill="{Binding DotBrush}" ToolTip="{Binding Status}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L IpAddress}" Binding="{Binding Ip}" SortMemberPath="IpSort" Width="Auto"/>
                                                <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L Hostname}" Binding="{Binding Hostname}" Width="*" MinWidth="70"/>
                                                <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L Mac}" Binding="{Binding Mac}" Width="Auto"/>
                                                <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L Vendor}" Binding="{Binding Vendor}" Width="Auto" MaxWidth="150"/>
                                                <DataGridTextColumn ElementStyle="{StaticResource ArchiveHeatCell}" Header="{loc:L ArchiveColAvgMs}" Binding="{Binding AvgText}" SortMemberPath="AvgSort" Width="Auto"/>
                                                <DataGridTextColumn ElementStyle="{StaticResource ArchiveNumberCell}" Header="{loc:L Min}" Binding="{Binding MinText}" SortMemberPath="MinSort" Width="Auto"/>
                                                <DataGridTextColumn ElementStyle="{StaticResource ArchiveNumberCell}" Header="{loc:L Max}" Binding="{Binding MaxText}" SortMemberPath="MaxSort" Width="Auto"/>
                                                <DataGridTextColumn ElementStyle="{StaticResource ArchiveNumberCell}" Header="{loc:L Jitter}" Binding="{Binding JitterText}" SortMemberPath="JitterSort" Width="Auto"/>
                                                <DataGridTextColumn ElementStyle="{StaticResource ArchiveLossCell}" Header="{loc:L Loss}" Binding="{Binding LossText}" SortMemberPath="LossSort" Width="Auto"/>
                                                <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L DeviceNote}" Binding="{Binding Note}" Width="Auto" MinWidth="56" MaxWidth="160"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock x:Name="DevicesHint" Style="{StaticResource ArchiveHint}"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{loc:L ArchiveTabPorts}" ToolTip="{loc:L ArchiveTabPorts}" AutomationProperties.Name="{loc:L ArchiveTabPorts}">
                                    <Grid>
                                        <DataGrid x:Name="PortsGrid" Style="{StaticResource ArchiveGrid}" PreviewMouseWheel="OnGridWheel"
                                                  AutomationProperties.Name="{loc:L ArchiveTabPorts}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L IpAddress}" Binding="{Binding Ip}" SortMemberPath="IpSort" Width="Auto"/>
                                                <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L ArchiveColKind}" Binding="{Binding KindLabel}" Width="Auto"/>
                                                <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L ErrorDialogDetails}" Binding="{Binding Detail}" Width="*" MinWidth="80"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock x:Name="PortsHint" Style="{StaticResource ArchiveHint}"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="{loc:L ArchiveTabHistory}" ToolTip="{loc:L ArchiveDeviceHistory}" AutomationProperties.Name="{loc:L ArchiveDeviceHistory}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="3*" MinHeight="90"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="90"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <DataGrid x:Name="HistoryGrid" Style="{StaticResource ArchiveGrid}" SelectionChanged="OnHistorySelected" PreviewMouseWheel="OnGridWheel"
                                                      AutomationProperties.Name="{loc:L ArchiveDeviceHistory}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L IpAddress}" Binding="{Binding Ip}" SortMemberPath="IpSort" Width="Auto"/>
                                                    <DataGridTextColumn ElementStyle="{StaticResource ArchiveCenterCell}" Header="{loc:L ArchiveAvailability}" Binding="{Binding Availability}" SortMemberPath="AvailabilitySort" Width="Auto"/>
                                                    <DataGridTextColumn ElementStyle="{StaticResource ArchiveCenterCell}" Header="{loc:L ArchiveLatencyTrend}" Binding="{Binding Latency}" SortMemberPath="LatencySort" Width="Auto"/>
                                                    <DataGridTextColumn x:Name="HistoryFirstSeenColumn" ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L ArchiveFirstSeen}" Binding="{Binding FirstSeen}" SortMemberPath="FirstSeenSort" Width="Auto"/>
                                                    <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L ArchiveLastSeen}" Binding="{Binding LastSeen}" SortMemberPath="LastSeenSort" Width="*" MinWidth="90"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock x:Name="HistoryHint" Style="{StaticResource ArchiveHint}"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{loc:L ArchiveTrendTitle}" Style="{StaticResource ArchiveSectionTitle}" Margin="0,10,0,6"/>
                                        <Grid Grid.Row="2">
                                            <DataGrid x:Name="TrendGrid" Style="{StaticResource ArchiveGrid}" PreviewMouseWheel="OnGridWheel" AutomationProperties.Name="{loc:L ArchiveTrendTitle}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L ArchiveDate}" Binding="{Binding Date}" Width="Auto"/>
                                                    <DataGridTextColumn ElementStyle="{StaticResource ArchiveCenterCell}" Header="{loc:L ArchiveAvailability}" Binding="{Binding Availability}" Width="Auto"/>
                                                    <DataGridTextColumn ElementStyle="{StaticResource ArchiveCenterCell}" Header="{loc:L ArchiveLatencyTrend}" Binding="{Binding Latency}" Width="*" MinWidth="90"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock x:Name="TrendHint" Style="{StaticResource ArchiveHint}" Margin="16,24,16,16" Text="{loc:L ArchiveTrendHint}"/>
                                        </Grid>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Comparison of two runs; replaces the overview while it is open. -->
            <Grid x:Name="CompareArea" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="CompareEmptyText" Grid.RowSpan="4" Foreground="{DynamicResource Subtext}" TextWrapping="Wrap"
                           Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                <Border x:Name="ComparePickers" Style="{StaticResource ArchiveCard}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="{loc:L CompareRunA}" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox x:Name="CompareRunABox" ToolTip="{loc:L TipCompareRunA}" Grid.Column="1" DisplayMemberPath="Label" SelectionChanged="OnCompareInputChanged"
                                  AutomationProperties.Name="{loc:L CompareRunA}"/>
                        <TextBlock Grid.Row="1" Text="{loc:L CompareRunB}" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,8,12,0"/>
                        <ComboBox x:Name="CompareRunBBox" ToolTip="{loc:L TipCompareRunB}" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" DisplayMemberPath="Label"
                                  SelectionChanged="OnCompareInputChanged" AutomationProperties.Name="{loc:L CompareRunB}"/>
                        <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                            <TextBlock Text="{loc:L CompareLatencyPercent}" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="ComparePercentBox" ToolTip="{loc:L TipComparePercent}" Width="54" Text="50" VerticalContentAlignment="Center" TextChanged="OnCompareInputChanged"
                                     AutomationProperties.Name="{loc:L CompareLatencyPercent}"/>
                            <TextBlock Text="{loc:L CompareLatencyMinMs}" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="14,0,6,0"/>
                            <TextBox x:Name="CompareMinMsBox" ToolTip="{loc:L TipCompareMinMs}" Width="54" Text="10" VerticalContentAlignment="Center" TextChanged="OnCompareInputChanged"
                                     AutomationProperties.Name="{loc:L CompareLatencyMinMs}"/>
                        </WrapPanel>
                    </Grid>
                </Border>
                <DockPanel x:Name="CompareActions" Grid.Row="1" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="CompareCopyButton" ToolTip="{loc:L TipCompareCopy}" Content="{loc:L CompareCopy}" Style="{StaticResource ArchiveSmallButton}" Click="OnCompareCopy"/>
                        <Button x:Name="CompareJsonButton" ToolTip="{loc:L TipCompareJson}" Content="{loc:L CompareSaveJson}" Style="{StaticResource ArchiveSmallButton}" Click="OnCompareSaveJson"/>
                        <Button x:Name="CompareTextButton" ToolTip="{loc:L TipCompareText}" Content="{loc:L CompareSaveText}" Style="{StaticResource ArchiveSmallButton}" Click="OnCompareSaveText"/>
                    </StackPanel>
                    <TextBlock x:Name="CompareSummaryText" Style="{StaticResource ArchiveSectionTitle}" TextWrapping="Wrap" Margin="0,0,8,0"
                               AutomationProperties.LiveSetting="Polite"/>
                </DockPanel>
                <TextBlock x:Name="CompareHintText" Grid.Row="2" Foreground="{DynamicResource Subtext}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Border x:Name="CompareFrame" Grid.Row="3" Style="{StaticResource ArchiveFrame}">
                    <DataGrid x:Name="CompareGrid" Style="{StaticResource ArchiveGrid}" AutomationProperties.Name="{loc:L ArchiveDetails}">
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource ChangeTypeCell}" Header="{loc:L CompareChange}" Binding="{Binding TypeLabel}" Width="Auto"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L IpAddress}" Binding="{Binding Ip}" Width="Auto"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L Hostname}" Binding="{Binding Hostname}" Width="*" MinWidth="80"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L CompareBefore}" Binding="{Binding Before}" Width="1.2*" MinWidth="90"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TrimmedCell}" Header="{loc:L CompareAfter}" Binding="{Binding After}" Width="1.2*" MinWidth="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>

        <!-- Housekeeping: age-based clean-up, then import and backup. -->
        <Border x:Name="ManagementRow" Grid.Row="2" Style="{StaticResource ArchiveCard}" Padding="10,4" Margin="0,12,0,0">
            <WrapPanel x:Name="ManagementPanel" IsEnabled="False" VerticalAlignment="Center">
                <Border Background="{DynamicResource Surface2}" CornerRadius="8" Padding="8,3" Margin="0,2,10,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="DaysBox" ToolTip="{loc:L TipArchiveDays}" Width="54" Text="30" Margin="0,0,6,0" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{loc:L ArchiveOlderThanDays}"/>
                        <TextBlock Text="{loc:L ArchiveOlderThanDays}" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="{loc:L ArchiveCompact}" Style="{StaticResource ArchiveSmallButton}" Margin="0,0,6,0" Click="OnCompact" ToolTip="{loc:L TipArchiveCompact}"/>
                        <Button Content="{loc:L ArchivePurge}" Style="{StaticResource ArchiveSmallButton}" Margin="0" Click="OnPurge" ToolTip="{loc:L TipArchivePurge}"/>
                    </StackPanel>
                </Border>
                <Button Content="{loc:L ArchiveImport}" Style="{StaticResource ArchiveSmallButton}" Margin="0,2,6,2" Click="OnImport" ToolTip="{loc:L TipArchiveImport}"/>
                <Button Content="{loc:L ArchiveBackup}" Style="{StaticResource ArchiveSmallButton}" Margin="0,2,0,2" Click="OnBackup" ToolTip="{loc:L TipArchiveBackup}"/>
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
