<Window x:Class="IpScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:IpScanner.Views.Controls"
        xmlns:views="clr-namespace:IpScanner.Views"
        xmlns:loc="clr-namespace:IpScanner.Core.Localization"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{loc:L AppTitle}" Height="720" Width="1320" MinWidth="700" MinHeight="480"
        Icon="Resources/network.ico" Background="{DynamicResource Bg}"
        WindowStartupLocation="Manual" PreviewMouseDown="OnWindowPreviewMouseDown"
        PreviewKeyDown="OnWindowKeyDown"
        StateChanged="OnWindowStateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <views:IconKeyConverter x:Key="IconKeyConv"/>
        <ContextMenu x:Key="DeviceRowMenu" Opened="OnDeviceRowMenuOpened">
            <MenuItem Header="{loc:L CopyIp}" Click="OnCopyIp"/>
            <MenuItem Header="{loc:L CopyMac}" Click="OnCopyMac"/>
            <MenuItem Header="{loc:L CopyHostname}" Click="OnCopyHostname"/>
            <MenuItem Header="{loc:L CopyOpenPorts}" Click="OnCopyOpenPorts"/>
            <MenuItem Header="{loc:L CopyRowAsText}" Click="OnCopyRowAsText"/>
            <Separator/>
            <MenuItem Header="{loc:L PinSelected}" Click="OnPinSelected"/>
            <MenuItem Header="{loc:L ScanAllPorts}" Click="OnScanSelectedPorts"/>
            <Separator/>
            <MenuItem Name="ResolveHostnameAgainItem" Header="{loc:L ResolveHostnameAgain}" Click="OnResolveHostnameAgain"/>
            <MenuItem Name="StopHostnameRetryItem" Header="{loc:L StopHostnameRetry}" IsCheckable="True" Click="OnToggleHostnameRetry"/>
            <MenuItem Name="MuteDeviceItem" Header="{loc:L MuteDevice}" IsCheckable="True" Click="OnToggleMuteDevice"/>
            <MenuItem Name="MarkAsKnownItem" Header="{loc:L MarkAsKnown}" Click="OnMarkAsKnown"/>
            <Separator/>
            <MenuItem Header="{loc:L WakeDevice}" Click="OnWake"/>
        </ContextMenu>

        <!-- The expanded row-detail content, kept out of RowDetailsTemplate itself:
             a collapsed row only inflates the empty ContentControl below, not this whole tree,
             because ContentTemplate is only ever set while ShowGraph is true. -->
        <DataTemplate x:Key="DeviceDetailTemplate">
            <Border Background="{DynamicResource BgDark}" Padding="14,8,14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Left: compact latency graph -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:L LatencyHistory}" Foreground="{DynamicResource Subtext}"
                                   FontSize="10" FontWeight="Bold"/>
                        <!-- Latency history over days - switch the graph below
                             between the live last-minute view and 24h/7d DB history. -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="{loc:L RangeMinute}" Tag="Minute" ToolTip="{loc:L TipRangeMinute}" FontSize="9" Padding="6,2"
                                    Click="OnLatencyRangeClick">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMinuteRange}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{loc:L RangeDay}" Tag="Day" ToolTip="{loc:L TipRangeDay}" FontSize="9" Padding="6,2" Margin="4,0,0,0"
                                    Click="OnLatencyRangeClick">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDayRange}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{loc:L RangeWeek}" Tag="Week" ToolTip="{loc:L TipRangeWeek}" FontSize="9" Padding="6,2" Margin="4,0,0,0"
                                    Click="OnLatencyRangeClick">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWeekRange}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <!-- A latency-over-time plot is not mirrored content even in
                             an RTL layout - force LTR so the time axis keeps running forward. -->
                        <Canvas Width="360" Height="60" Margin="0,6,0,0" ClipToBounds="True"
                                HorizontalAlignment="Left" SizeChanged="OnRowGraphSizeChanged" FlowDirection="LeftToRight">
                            <Path Data="{Binding RowGraphBands}" Fill="{DynamicResource Red}" Opacity="0.22"/>
                            <Path Data="{Binding RowGraphLoss}" Stroke="{DynamicResource Red}" StrokeThickness="2"/>
                            <Path Data="{Binding RowGraphLine}" Stroke="{DynamicResource Green}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round"/>
                            <TextBlock Text="{Binding RowGraphMax}" Canvas.Left="4" Canvas.Top="1"
                                       FontSize="9" Foreground="{DynamicResource MidGray}"/>
                            <TextBlock Text="{Binding RowGraphMin}" Canvas.Left="4" Canvas.Bottom="0"
                                       FontSize="9" Foreground="{DynamicResource MidGray}"/>
                            <ItemsControl ItemsSource="{Binding RowGraphTicks}" Canvas.Left="0" Canvas.Top="46">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/></Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="8" Foreground="{DynamicResource MidGray}" Width="28" TextAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="{loc:L Vendor}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,12,2"/>
                            <TextBlock Grid.Column="1" Text="{Binding Vendor}" Foreground="{DynamicResource Text}" FontSize="11" Margin="0,0,0,2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Row="1" Text="{loc:L Mac}" Foreground="{DynamicResource Subtext}" FontSize="11" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Mac}" Foreground="{DynamicResource Text}" FontSize="11"/>
                        </Grid>
                        <!-- IP/MAC conflict hint for this specific device, if any. -->
                        <TextBlock Text="{Binding ConflictHint}" Foreground="{DynamicResource Peach}" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding HasConflictHint, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{loc:L DeviceNote}" Foreground="{DynamicResource Subtext}"
                                   FontSize="10" FontWeight="Bold" Margin="0,6,0,3"/>
                        <TextBox Text="{Binding NoteDraft, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                                 MinHeight="40" MaxHeight="84" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="{loc:L DeviceNote}"
                                 AutomationProperties.HelpText="{loc:L DeviceNoteHint}"
                                 LostFocus="OnDeviceNoteLostFocus">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="ToolTip" Value="{loc:L DeviceNoteHint}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNoteTooLong}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Red}"/>
                                            <Setter Property="ToolTip" Value="{Binding NoteValidationText}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding NoteValidationText}" Foreground="{DynamicResource Red}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <!-- Right: reachable services, a fixed-width column so the list never runs off to the side -->
                    <StackPanel Grid.Column="1" Width="360" HorizontalAlignment="Left" Margin="24,0,0,0">
                        <TextBlock Text="{loc:L Services}" Foreground="{DynamicResource Subtext}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="{loc:L ScanAllPorts}" FontSize="10" Padding="8,3"
                                    ToolTip="{loc:L TipScanAllPorts}" Click="OnScanAllPortsClick">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFullPortScanRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Save this device's open ports as a text file. -->
                            <Button Content="{loc:L SavePorts}" FontSize="10" Padding="8,3" Margin="6,0,0,0"
                                    ToolTip="{loc:L TipSavePorts}" Click="OnSavePortsClick">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Services.Count}" Value="0">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding IsFullPortScanRunning, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Width="120" Height="10" Minimum="0" Maximum="1"
                                             Value="{Binding FullPortScanFraction, Mode=OneWay}"/>
                                <TextBlock Text="{Binding FullPortScanStatusText}" FontSize="10"
                                           Foreground="{DynamicResource MidGray}" VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                                <TextBlock Text="{Binding FullPortScanFoundText}" FontSize="10"
                                           Foreground="{DynamicResource MidGray}" VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                                <TextBlock Text="{Binding FullPortScanEtaText}" FontSize="10"
                                           Foreground="{DynamicResource MidGray}" VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                                <Button Content="✕" FontSize="10" Padding="6,2" Margin="6,0,0,0"
                                        Style="{StaticResource GhostButton}" ToolTip="{loc:L Stop}"
                                        AutomationProperties.Name="{loc:L Stop}" Click="OnCancelFullPortScanClick"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{Binding PortScanResultHeader}" Foreground="{DynamicResource Subtext}"
                                   FontSize="10" Margin="0,0,0,6"
                                   Visibility="{Binding HasPortScanResult, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding PortScanErrorText}" Foreground="{DynamicResource Red}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding HasPortScanError, Converter={StaticResource BoolToVis}}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock Text="{loc:L ScanningPorts}" Foreground="{DynamicResource MidGray}" FontSize="11"
                                   Visibility="{Binding IsScanningServices, Converter={StaticResource BoolToVis}}"/>
                        <Grid Margin="0,0,0,6">
                            <TextBox Text="{Binding ServiceFilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:L TipServiceFilter}"
                                     Height="24" VerticalContentAlignment="Center" Padding="6,0" FontSize="11"/>
                            <TextBlock Text="{loc:L ServiceSearchPlaceholder}" Foreground="{DynamicResource MidGray}" FontSize="11"
                                       IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServiceFilterText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding ServicesEmptyText}" Foreground="{DynamicResource MidGray}" FontSize="11"
                                   Visibility="{Binding IsServicesEmptyVisible, Converter={StaticResource BoolToVis}}"/>
                        <!-- One service per row in a virtualized list: a full sweep on a host that answers
                             everywhere can list 65535 ports, which a wrapping panel would realize all at once. -->
                        <ItemsControl ItemsSource="{Binding ServicesView}" MaxHeight="168"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True" Focusable="False">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True" Focusable="False">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                                            </Style>
                                        </ScrollViewer.Resources>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ServiceChip}" HorizontalAlignment="Stretch"
                                            MinWidth="0" MaxWidth="10000" Margin="0,0,0,3" Padding="8,3"
                                            Click="OnServiceClick" ToolTip="{Binding TooltipText}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PortLabel}" FontSize="11" Foreground="{DynamicResource Subtext}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayNameShort}" FontSize="12" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsOpenable}" Value="True"/>
                                                                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=IsMouseOver}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="TextDecorations" Value="Underline"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar: replaces the native chrome; WindowChrome above marks this
             36px row as the drag/maximize caption area, minus the buttons which opt back in via
             IsHitTestVisibleInChrome. -->
        <Border Grid.Row="0" Background="{DynamicResource BgDark}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="Resources/logo.png" Width="16" Height="16" Margin="10,0,6,0"
                       VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{loc:L AppTitle}" Foreground="{DynamicResource Subtext}"
                           FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" FlowDirection="LeftToRight"
                            Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="{loc:L ManualExportAction}" Click="OnManualExport" ToolTip="{loc:L TipManualExport}"
                            Style="{StaticResource TitleBarTextButton}" AutomationProperties.Name="{loc:L ManualExportAction}"/>
                    <Button Content="{loc:L CopyView}" Style="{StaticResource TitleBarTextButton}" Click="OnOpenCopyViewMenu" ToolTip="{loc:L TipCopyView}"
                            AutomationProperties.Name="{loc:L CopyView}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:L CopyViewText}" Click="OnCopyViewText"/>
                                <MenuItem Header="{loc:L CopyViewTable}" Click="OnCopyViewTable"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" FlowDirection="LeftToRight"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                            Click="OnMinimizeClick" AutomationProperties.Name="{loc:L Minimize}">
                        <Viewbox Width="11" Height="11">
                            <Path Fill="{DynamicResource Text}" Data="M20,14H4V10H20Z"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButton}"
                            Click="OnMaximizeRestoreClick" AutomationProperties.Name="{loc:L Maximize}">
                        <Viewbox Width="11" Height="11">
                            <Path x:Name="MaximizeRestoreGlyph" Fill="{DynamicResource Text}" Data="M4,4H20V20H4V4M6,6V18H18V6H6Z"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}"
                            Click="OnCloseClick" AutomationProperties.Name="{loc:L Close}">
                        <Path Width="8" Height="8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource Text}" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header + main content scroll horizontally instead of clipping when text scale needs more width than the window has; the title bar above stays outside
             this ScrollViewer so it never scrolls the whole window, header included, at plain narrow
             widths (the WrapPanel/Stretch below handles those, so this one only ever engages
             from scale). Vertical stays fixed to the viewport: the
             DataGrid and sidebar already scroll themselves. -->
        <ScrollViewer x:Name="ScaledScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <Grid x:Name="ScaledContent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BgDark}" Padding="12,8">
            <Grid x:Name="HeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title + logo -->
                <StackPanel x:Name="HeaderLogoPanel" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{loc:L AppTitle}" Foreground="{DynamicResource Text}"
                               FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    <!-- Spins on its own composition thread - immune to UI load -->
                    <ctrl:SpinningLogo x:Name="Logo" Width="42" Height="42" Margin="0,5,0,0"
                                       HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Center: progress bars -->
                <StackPanel x:Name="HeaderProgress" Grid.Column="1" Margin="18,0" MinWidth="220" VerticalAlignment="Center"
                            HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ProgLabel"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:L Devices}" Foreground="{DynamicResource Subtext}" FontSize="11"
                                   HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ctrl:SegmentedProgressBar x:Name="DevBar" Grid.Column="1" Height="13"
                            Track="{DynamicResource Surface}"
                            Color1="{DynamicResource Green}" Color2="{DynamicResource Red}"
                            Fraction1="{Binding Progress.OnlineFraction}"
                            Fraction2="{Binding Progress.OfflineFraction}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Progress.DeviceCountText}" FlowDirection="LeftToRight"
                                       Foreground="{DynamicResource Text}" FontSize="10"/>
                            <!-- Remaining-time estimate, empty below 5 % progress or in infinite ping mode -->
                            <TextBlock Text="{Binding Progress.EtaText}"
                                       Foreground="{DynamicResource Subtext}" FontSize="10" Margin="6,0,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="OfflineToggle" Grid.Column="3" Content="{loc:L ShowOfflineDb}"
                                      Style="{StaticResource PillToggle}" FontSize="11" Padding="12,4" Margin="8,0,0,0"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                      Click="OnToggleOffline" ToolTip="{loc:L TipShowOfflineDb}"/>
                    </Grid>
                    <!-- Devices legend (squares are clickable color pickers) -->
                    <StackPanel Orientation="Horizontal" Margin="56,0,0,4">
                        <Border x:Name="LegOnline" Tag="online" Background="{DynamicResource Green}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OnLegendColorClick"/>
                        <TextBlock Text="{Binding Progress.OnlineText}" Foreground="{DynamicResource Subtext}" FontSize="10" Margin="4,0,10,0"/>
                        <Border x:Name="LegOffline" Tag="offline" Background="{DynamicResource Red}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OnLegendColorClick"/>
                        <TextBlock Text="{Binding Progress.OfflineText}" Foreground="{DynamicResource Subtext}" FontSize="10" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="ProgLabel"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:L Pings}" Foreground="{DynamicResource Subtext}" FontSize="11"
                                   HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ctrl:SegmentedProgressBar x:Name="PingBar" Grid.Column="1" Height="13"
                            Track="{DynamicResource Surface}"
                            Color1="{DynamicResource Green}" Color2="{DynamicResource Red}" Color3="{DynamicResource MidGray}"
                            Fraction1="{Binding Progress.SuccessFraction}"
                            Fraction2="{Binding Progress.FailedFraction}"
                            Fraction3="{Binding Progress.SkippedFraction}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Progress.PingCountText}" FlowDirection="LeftToRight" ToolTip="{Binding Progress.PingCountTip}"
                                   Foreground="{DynamicResource Text}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Pings legend (squares are clickable color pickers) -->
                    <StackPanel Orientation="Horizontal" Margin="56,4,0,0">
                        <Border x:Name="LegSuccess" Tag="success" Background="{DynamicResource Green}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OnLegendColorClick"/>
                        <TextBlock Text="{Binding Progress.SuccessText}" Foreground="{DynamicResource Subtext}" FontSize="10" Margin="4,0,10,0"/>
                        <Border x:Name="LegFailed" Tag="failed" Background="{DynamicResource Red}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OnLegendColorClick"/>
                        <TextBlock Text="{Binding Progress.FailedText}" Foreground="{DynamicResource Subtext}" FontSize="10" Margin="4,0,10,0"/>
                        <!-- Hidden by default, re-enabled via "Anzeige"; still counted either way. -->
                        <StackPanel x:Name="SkippedLegendPanel" Orientation="Horizontal" Visibility="Collapsed">
                            <Border x:Name="LegSkipped" Tag="skipped" Background="{DynamicResource MidGray}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="OnLegendColorClick"/>
                            <TextBlock Text="{Binding Progress.SkippedText}" Foreground="{DynamicResource Subtext}" FontSize="10" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Right: subnet input above the scan controls. Two stacked rows so the toolbar
                     only needs the width of its wider row; each row wraps inside its own panel. -->
                <StackPanel x:Name="HeaderControls" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                        <Grid Width="160" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBox x:Name="SubnetBox" FlowDirection="LeftToRight" Height="30"
                                     Foreground="{DynamicResource Text}" FontSize="12" VerticalContentAlignment="Center" Padding="8,0"
                                     KeyDown="OnSubnetKeyDown" TextChanged="OnSubnetTextChanged" ToolTip="{loc:L SubnetTooltip}"
                                     AutomationProperties.Name="{loc:L SubnetTooltip}"/>
                            <TextBlock Text="{Binding DetectedCidr}" Foreground="{DynamicResource MidGray}" FontSize="12" IsHitTestVisible="False"
                                       Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SubnetBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox x:Name="CidrBox" FlowDirection="LeftToRight" Width="80" Height="30" SelectedIndex="0" IsEditable="True" IsEnabled="False"
                                  VerticalAlignment="Center" ToolTip="{loc:L MaskTooltip}" AutomationProperties.Name="{loc:L MaskTooltip}">
                            <sys:String>/24</sys:String>
                            <sys:String>/20</sys:String>
                            <sys:String>/16</sys:String>
                        </ComboBox>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{loc:L PingsLabel}" Foreground="{DynamicResource Subtext}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="PingCountBox" ToolTip="{loc:L TipPingCount}" Width="80" Margin="0,0,6,0" SelectedIndex="0" IsEditable="True"
                                  AutomationProperties.Name="{loc:L PingsLabel}">
                            <sys:String>10</sys:String><sys:String>100</sys:String>
                            <sys:String>1000</sys:String><sys:String>10000</sys:String>
                            <sys:String>100000</sys:String><sys:String>∞</sys:String>
                        </ComboBox>
                        <Button x:Name="ScanStopButton" Content="{loc:L Scan}" Click="OnScanStopClick" ToolTip="{loc:L TipScanButton}"
                                Style="{StaticResource AccentButton}" MinWidth="86"/>
                        <Button Click="OnSettingsClick" Style="{StaticResource IconButton}"
                                ToolTip="{loc:L Settings}" AutomationProperties.Name="{loc:L Settings}">
                            <!-- An icon glyph is not mirrored content even in RTL. -->
                            <Viewbox Width="16" Height="16" FlowDirection="LeftToRight">
                                <!-- Gear (cog) vector -->
                                <Path Fill="{DynamicResource Text}" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                            </Viewbox>
                        </Button>
                        <!-- Opens the non-modal Tools window, right of the gear. -->
                        <Button x:Name="ToolsButton" Click="OnToolsClick" Style="{StaticResource IconButton}"
                                ToolTip="{loc:L Tools}" AutomationProperties.Name="{loc:L Tools}">
                            <Viewbox Width="16" Height="16" FlowDirection="LeftToRight">
                                <!-- Wrench vector -->
                                <Path Fill="{DynamicResource Text}" Data="M22.7,19L13.6,9.9C14.5,7.6 14,4.9 12.1,3C10.1,1 7.1,0.6 4.7,1.7L9,6L6,9L1.6,4.7C0.4,7.1 0.9,10.1 2.9,12.1C4.8,14 7.5,14.5 9.8,13.6L18.9,22.7C19.3,23.1 19.9,23.1 20.3,22.7L22.6,20.4C23.1,20 23.1,19.3 22.7,19Z"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="ArchiveButton" Content="{loc:L ArchiveTitle}" Click="OnArchiveClick" ToolTip="{loc:L TipArchiveButton}"
                                Style="{StaticResource GhostButton}" Padding="10,7" Margin="6,0,0,0"
                                AutomationProperties.Name="{loc:L ArchiveTitle}"/>
                        <Button x:Name="LogButton" Content="{loc:L LogTitle}" Click="OnLogClick" ToolTip="{loc:L TipLogButton}"
                                Style="{StaticResource GhostButton}" Padding="10,7" Margin="6,0,0,0"
                                AutomationProperties.Name="{loc:L LogTitle}"/>
                        <!-- Ctrl+B toggles the same collapse this button triggers. -->
                        <Button x:Name="SidebarToggleButton" Click="OnToggleSidebarClick" Style="{StaticResource IconButton}"
                                ToolTip="{loc:L ToggleSidebar}" AutomationProperties.Name="{loc:L ToggleSidebar}">
                            <Viewbox Width="16" Height="16" FlowDirection="LeftToRight">
                                <!-- Sidebar vector -->
                                <Path Fill="{DynamicResource Text}" Data="M4,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M4,6V18H9V6H4M11,6V18H20V6H11Z"/>
                            </Viewbox>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Packet reader notice: shown while the driver-only scan types are unavailable. -->
        <Border x:Name="DriverBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource BgDark}"
                BorderBrush="{DynamicResource Surface}" BorderThickness="0,1,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DriverCloseBtn" Grid.Column="0" ToolTip="{loc:L TipDriverClose}" AutomationProperties.Name="{loc:L TipDriverClose}"
                        Style="{StaticResource IconButton}" Padding="8,5" Margin="0,0,8,0" VerticalAlignment="Center" Click="OnDriverClose">
                    <Path Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource Text}" Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                </Button>
                <Viewbox Grid.Column="1" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Path Fill="{DynamicResource Mauve}" Data="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"/>
                </Viewbox>
                <TextBlock x:Name="DriverBarMessage" Grid.Column="2" FontSize="12" Foreground="{DynamicResource Text}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <WrapPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="DriverGetBtn" Content="{loc:L DriverGet}" ToolTip="{loc:L TipDriverGet}"
                            Style="{StaticResource AccentButton}" FontSize="12" Padding="10,3" Margin="0,0,6,0" Click="OnDriverGet"/>
                    <Button x:Name="DriverDetailsBtn" Content="{loc:L DriverDetails}" ToolTip="{loc:L TipDriverDetails}"
                            Style="{StaticResource GhostButton}" FontSize="12" Padding="8,3" Click="OnDriverDetails"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Main: table + sidebar -->
        <Grid x:Name="MainArea" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="SidebarColumn" Width="340" MinWidth="280" MaxWidth="560"/>
            </Grid.ColumnDefinitions>

            <!-- Drag handle: resizes the sidebar within MinWidth/MaxWidth of the column, persisted. -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" Cursor="SizeWE" DragCompleted="OnSidebarResized"/>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
            <StackPanel Grid.Row="1">
            <!-- Shown only until a config file exists on disk for the
                 first time - see IsFreshInstall / OnFirstRunAction. -->
            <Border x:Name="FirstRunCard" Visibility="Collapsed" Margin="10,0,10,8"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Mauve}"
                    BorderThickness="1" CornerRadius="6" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="{loc:L FirstRunTitle}" Foreground="{DynamicResource Mauve}" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="FirstRunNetworkText" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="FirstRunConfigText" FontSize="11" Foreground="{DynamicResource Subtext}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="FirstRunDatabaseText" FontSize="11" Foreground="{DynamicResource Subtext}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="FirstRunReportsText" FontSize="11" Foreground="{DynamicResource Subtext}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    <CheckBox x:Name="FirstRunUpdatesBox" ToolTip="{loc:L TipFirstRunUpdates}" IsChecked="False"
                              Foreground="{DynamicResource Text}" FontSize="12" Margin="0,10,0,0"
                              AutomationProperties.Name="{loc:L FirstRunCheckUpdates}">
                        <TextBlock Text="{loc:L FirstRunCheckUpdates}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="FirstRunInternetBox" ToolTip="{loc:L TipFirstRunInternet}" IsChecked="False"
                              Foreground="{DynamicResource Text}" FontSize="12" Margin="0,6,0,0"
                              AutomationProperties.Name="{loc:L FirstRunMeasureInternet}">
                        <TextBlock Text="{loc:L FirstRunMeasureInternet}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="{loc:L FirstRunScanNow}" Click="OnFirstRunScanNow" ToolTip="{loc:L TipFirstRunScan}" Style="{StaticResource AccentButton}" Padding="14,6"/>
                        <Button Content="{loc:L Settings}" Click="OnFirstRunOpenSettings" ToolTip="{loc:L TipFirstRunSettings}" Style="{StaticResource GhostButton}" Padding="14,6" Margin="8,0,0,0"/>
                        <Button Content="{loc:L FirstRunDismiss}" Click="OnFirstRunDismiss" ToolTip="{loc:L TipFirstRunDismiss}" Style="{StaticResource GhostButton}" Padding="14,6" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
            <StackPanel Grid.Row="0" Margin="10,8">
            <Grid x:Name="FilterRowGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Column="0" MinWidth="240">
                    <TextBox x:Name="FilterBox" ToolTip="{loc:L TipFilterBox}" Height="30" VerticalContentAlignment="Center" Padding="8,0" FontSize="12" TextChanged="OnFilterChanged"
                             AutomationProperties.Name="{loc:L FilterPlaceholder}"/>
                    <TextBlock Text="{loc:L FilterPlaceholder}" Foreground="{DynamicResource MidGray}" FontSize="12" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                <!-- Quick filter pills, ANDed with each other and with the text filter;
                     session-only state, not persisted. -->
                <WrapPanel x:Name="QuickPills" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <ToggleButton x:Name="OnlinePill" ToolTip="{loc:L TipPillOnline}" Content="{loc:L FilterOnlineOnly}" Style="{StaticResource PillToggle}" Click="OnQuickFilterToggle"/>
                    <ToggleButton x:Name="PinnedPill" ToolTip="{loc:L TipPillPinned}" Content="{loc:L FilterPinnedOnly}" Style="{StaticResource PillToggle}" Click="OnQuickFilterToggle" Margin="6,0,0,0"/>
                    <ToggleButton x:Name="UnknownPill" ToolTip="{loc:L TipPillUnknown}" Content="{loc:L FilterUnknownOnly}" Style="{StaticResource PillToggle}" Click="OnQuickFilterToggle" Margin="6,0,0,0"/>
                </WrapPanel>
            </Grid>
            </StackPanel>
            <DataGrid x:Name="DeviceGrid" Grid.Row="2" ItemsSource="{Binding Devices}" AutoGenerateColumns="False"
                      IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
                      RowBackground="{DynamicResource Bg}" AlternatingRowBackground="{DynamicResource BgAlt}"
                      BorderThickness="0" EnableRowVirtualization="True"
                      RowDetailsVisibilityMode="Visible" CanUserReorderColumns="False"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"
                      Sorting="OnColumnSorting"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      SelectionChanged="OnDeviceGridSelectionChanged"
                      AutomationProperties.Name="{loc:L Devices}">
                <!-- Click a row to expand a latency graph of its last pings; click again to hide.
                     Details mode stays Visible; the template collapses itself via ShowGraph
                     (binding RowDetailsVisibilityMode per-row is overridden by the grid). -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnDeviceRowClick"/>
                        <Setter Property="ContextMenu" Value="{StaticResource DeviceRowMenu}"/>
                        <Style.Triggers>
                            <!-- New/unknown device (online, MAC not in the database): subtle tint. -->
                            <DataTrigger Binding="{Binding IsRogue}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RogueBg}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <!-- Collapsed rows inflate only this empty ContentControl - the real
                             tree (DeviceDetailTemplate above) is set as ContentTemplate, and
                             therefore built, only once ShowGraph goes true. -->
                        <ContentControl Content="{Binding}" Focusable="False">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <!-- Without a template the row object would render as its type name. -->
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowGraph}" Value="True">
                                            <Setter Property="ContentTemplate" Value="{StaticResource DeviceDetailTemplate}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="IpColumn" Header="{loc:L IpAddress}" Width="Auto" MinWidth="140"
                                            SortMemberPath="IpSortKey">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Pin icon: hover turns red X, click unpins -->
                                    <TextBlock FontWeight="SemiBold" Cursor="Hand"
                                               ToolTip="{loc:L TipUnpinIp}"
                                               MouseLeftButtonDown="OnPinIconClick">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Text" Value="📌 "/>
                                                <Setter Property="Foreground" Value="{Binding IpColor}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Text" Value="✕  "/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Red}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- IP text: click to pin (if not already pinned) -->
                                    <TextBlock Text="{Binding IpText}" Foreground="{Binding IpColor}"
                                               FontWeight="SemiBold" FontFamily="Consolas"
                                               MaxWidth="230" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding IpTooltip}"
                                               MouseLeftButtonDown="OnIpTextClick">
                                        <TextBlock.Style><Style TargetType="TextBlock">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="StatusColumn" Header="{loc:L Status}" Width="Auto" MinWidth="84"
                                            SortMemberPath="IsOnline">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="GroupColumn" Header="{loc:L Group}" Width="Auto" MinWidth="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent" MouseLeftButtonDown="OnGroupCellClick"
                                      ToolTip="{loc:L TipGroupColorCell}">
                                    <!-- The ungrouped chip is Surface2, the same color as a selected cell, so a
                                         selected row outlines the chip to keep it visible. -->
                                    <Border x:Name="GroupChip" Width="14" Height="14" CornerRadius="2" HorizontalAlignment="Center"
                                            Background="{Binding GroupColor}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Subtext}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="HostnameColumn" Header="{loc:L Hostname}" Width="*" MinWidth="110"
                                            SortMemberPath="Hostname">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent" MouseLeftButtonDown="OnHostnameCellClick"
                                      ToolTip="{loc:L TipEditCell}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{Binding DeviceTypeIconKey, Converter={StaticResource IconKeyConv}}"
                                              Fill="{DynamicResource Subtext}" Width="13" Height="13" Stretch="Uniform"
                                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Hostname}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Hostname}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="AvgColumn" Header="{loc:L Avg}" Width="Auto" MinWidth="80"
                                            SortMemberPath="AvgRaw">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Style="{StaticResource StaleValueCell}">
                                    <TextBlock Text="{Binding AvgMark}" Foreground="{Binding AvgMarkColor}" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding AvgDisplay}" Foreground="{Binding AvgColor}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="MinColumn" Header="{loc:L Min}" Width="Auto" MinWidth="72"
                                            SortMemberPath="MinRaw">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Style="{StaticResource StaleValueCell}">
                                    <TextBlock Text="{Binding MinMark}" Foreground="{Binding MinMarkColor}" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding MinDisplay}" Foreground="{Binding MinColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="MaxColumn" Header="{loc:L Max}" Width="Auto" MinWidth="72"
                                            SortMemberPath="MaxRaw">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Style="{StaticResource StaleValueCell}">
                                    <TextBlock Text="{Binding MaxMark}" Foreground="{Binding MaxMarkColor}" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding MaxDisplay}" Foreground="{Binding MaxColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="LastColumn" Header="{loc:L Last}" Width="Auto" MinWidth="84"
                                            SortMemberPath="LastRaw">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Style="{StaticResource StaleValueCell}">
                                    <TextBlock Text="{Binding LastMark}" Foreground="{Binding LastMarkColor}" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding LastDisplay}" Foreground="{Binding LastColor}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="LossColumn" Header="{loc:L Loss}" Binding="{Binding LossDisplay}" Width="Auto" MinWidth="64"
                                        ElementStyle="{StaticResource CenterCell}">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="{loc:L LossTip}"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="JitterColumn" Header="{loc:L Jitter}" Binding="{Binding JitterDisplay}" Width="Auto" MinWidth="72"
                                        ElementStyle="{StaticResource CenterCell}">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="{loc:L JitterTip}"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="ProgressColumn" Header="{loc:L Progress}" Binding="{Binding ProgressDisplay}" Width="Auto" MinWidth="84"
                                        ElementStyle="{StaticResource CenterCell}"/>
                    <DataGridTextColumn x:Name="MacColumn" Header="{loc:L Mac}" Binding="{Binding Mac}" Width="Auto" MinWidth="136"
                                        ElementStyle="{StaticResource CenterCell}"/>
                    <DataGridTextColumn x:Name="VendorColumn" Header="{loc:L Vendor}" Binding="{Binding VendorDisplay}" SortMemberPath="Vendor" Width="Auto" MinWidth="110" MaxWidth="220">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="4,0"/>
                                <Setter Property="ToolTip" Value="{Binding VendorTip}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPrivateMac}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Subtext}"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="PortsColumn" Header="{loc:L ColPorts}" Binding="{Binding Ports}" SortMemberPath="PortsSortKey" Width="Auto" MinWidth="90" MaxWidth="200">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="{loc:L TipColPorts}"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}">
                                <Setter Property="ToolTip" Value="{Binding PortsTip}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="MethodColumn" Header="{loc:L FoundBy}" Binding="{Binding Method}" Width="Auto" MinWidth="90" MaxWidth="180">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}">
                                <Setter Property="ToolTip" Value="{Binding Method}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="OsColumn" Header="{loc:L OsColumnHeader}" Binding="{Binding Os}" Width="Auto" MinWidth="160" MaxWidth="240">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}">
                                <Setter Property="ToolTip" Value="{Binding OsTip}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="FirstSeenColumn" Header="{loc:L ColFirstSeen}" Binding="{Binding FirstSeenText}" SortMemberPath="FirstSeenSortKey" Width="Auto" MinWidth="120" MaxWidth="200">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="{loc:L TipColFirstSeen}"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="LastSeenColumn" Header="{loc:L ColLastSeen}" Binding="{Binding LastSeenText}" SortMemberPath="LastSeenSortKey" Width="Auto" MinWidth="120" MaxWidth="200">
                        <DataGridTextColumn.HeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                <Setter Property="ToolTip" Value="{loc:L TipColLastSeen}"/>
                            </Style>
                        </DataGridTextColumn.HeaderStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Totals row: column averages across all visible devices -->
            <Border Grid.Row="3" Background="{DynamicResource BgDark}"
                    BorderBrush="{DynamicResource Surface}" BorderThickness="0,1,0,0" Padding="10,6">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel x:Name="SelectedPortScanProgress" Orientation="Horizontal" Visibility="Collapsed"
                                VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite">
                        <TextBlock x:Name="SelectedPortScanText" Foreground="{DynamicResource Peach}" FontSize="11" VerticalAlignment="Center"/>
                        <Button Content="✕" FontSize="10" Padding="6,2" Margin="6,0,0,0"
                                Style="{StaticResource GhostButton}" ToolTip="{loc:L Stop}"
                                AutomationProperties.Name="{loc:L Stop}" Click="OnCancelSelectedPortScanClick"/>
                    </StackPanel>
                    <TextBlock x:Name="SelectionCountText" Foreground="{DynamicResource Mauve}"
                               FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"
                               Margin="0,0,12,0" Visibility="Collapsed"
                               AutomationProperties.LiveSetting="Polite"/>
                    <!-- Permanent last-scan timestamp, replaces nothing (there was no
                         persistent equivalent before) - stays visible next to the thread count. -->
                    <TextBlock Text="{Binding LastScanText}" Foreground="{DynamicResource Subtext}"
                               FontSize="11" VerticalAlignment="Center"
                               Visibility="{Binding HasLastScan, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding ThreadsText}" Foreground="{DynamicResource Subtext}"
                               FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{loc:L TotalRow}" Foreground="{DynamicResource Mauve}"
                               FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock Text="{loc:L Avg}" Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalAvg}" Foreground="{Binding TotalAvgColor}" FontWeight="SemiBold" FontSize="11" Margin="5,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:L Min}" Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalMin}" Foreground="{Binding TotalMinColor}" FontWeight="SemiBold" FontSize="11" Margin="5,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:L Max}" Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalMax}" Foreground="{Binding TotalMaxColor}" FontWeight="SemiBold" FontSize="11" Margin="5,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:L Last}" Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalLast}" Foreground="{Binding TotalLastColor}" FontWeight="SemiBold" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                </Grid>
            </Border>
            </Grid>

            <!-- Sidebar -->
            <Border x:Name="SidebarPanel" Grid.Column="2" Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource Surface}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Profile switcher: each profile keeps its own networks, pinned IPs and
                             internet hosts, so it sits above the lists it switches. With only the
                             default profile the row shows just the add button. -->
                        <Border Padding="13,10" BorderBrush="{DynamicResource Surface}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ProfileLabel" Grid.Column="0" Text="{loc:L ProfileLabel}"
                                           Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="ProfileBox" Grid.Column="1" Height="30" MinWidth="90" VerticalAlignment="Center" Margin="0,0,4,0"
                                          SelectionChanged="OnProfileChanged" ToolTip="{loc:L TipProfile}"/>
                                <Button x:Name="ProfileEditBtn" Grid.Column="2" Content="✎" Width="30" Height="30" FontSize="13"
                                        Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,4,0"
                                        Click="OnProfileEditClick" ToolTip="{loc:L TipProfileRename}" AutomationProperties.Name="{loc:L TipProfileRename}"
                                        Visibility="Collapsed"/>
                                <Button x:Name="ProfileAddBtn" Grid.Column="3" Content="+" Width="30" Height="30" FontSize="16"
                                        Style="{StaticResource GhostButton}" Padding="0"
                                        Click="OnProfileAddClick" ToolTip="{loc:L TipProfileAdd}" AutomationProperties.Name="{loc:L TipProfileAdd}"/>
                            </Grid>
                        </Border>
                        <!-- Export toggles + last written files (collapsed by default) -->
                        <Border Padding="13,12" BorderBrush="{DynamicResource Surface}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <ToggleButton x:Name="ExportsHeaderToggle" ToolTip="{loc:L TipExportsHeader}" Style="{StaticResource SidebarFlatToggle}" Click="OnToggleExportsExpanded"
                                              AutomationProperties.Name="{Binding ExportsHeaderText}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ExportsHeaderText}"
                                                   Foreground="{DynamicResource Subtext}" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ExportsChevron" Grid.Column="1" Text="&#9656;"
                                                   Foreground="{DynamicResource MidGray}" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="ExportsContent" Visibility="Collapsed" Margin="0,9,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button x:Name="OpenScansButton" Style="{StaticResource IconButton}" Margin="0,0,10,0"
                                                VerticalAlignment="Center" Click="OnOpenScansFolder"
                                                ToolTip="{loc:L TipOpenScans}" AutomationProperties.Name="{loc:L TipOpenScans}">
                                            <!-- An icon glyph is not mirrored content even in RTL. -->
                                            <Viewbox Width="15" Height="15" FlowDirection="LeftToRight">
                                                <!-- Folder vector -->
                                                <Path Fill="{DynamicResource Text}" Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
                                            </Viewbox>
                                        </Button>
                                        <ToggleButton x:Name="TxtToggle" Content="{loc:L TxtExport}" Style="{StaticResource PillToggle}"
                                                      Click="OnExportToggle" ToolTip="{loc:L TipWriteTxt}"/>
                                        <ToggleButton x:Name="CsvToggle" Content="{loc:L CsvExport}" Style="{StaticResource PillToggle}"
                                                      Click="OnExportToggle" Margin="10,0,0,0" ToolTip="{loc:L TipExportCsv}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ExportInfo}" Foreground="{DynamicResource MidGray}" FontSize="10"
                                               TextWrapping="Wrap" Margin="0,9,0,0" HorizontalAlignment="Center"
                                               Visibility="{Binding HasExport, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- IP/MAC conflict findings from the last scan - hidden
                             entirely when there is nothing to report (no permanent empty box). -->
                        <Border Padding="13,12" BorderBrush="{DynamicResource Surface}" BorderThickness="0,0,0,1"
                                Visibility="{Binding HasConflictFindings, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <ToggleButton x:Name="FindingsHeaderToggle" Style="{StaticResource SidebarFlatToggle}" Click="OnToggleFindingsExpanded" IsChecked="True"
                                              AutomationProperties.Name="{Binding FindingsHeaderText}"
                                        ToolTip="{loc:L TipFindingsSection}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding FindingsHeaderText}"
                                                   Foreground="{DynamicResource Peach}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="FindingsChevron" Grid.Column="1" Text="&#9662;"
                                                   Foreground="{DynamicResource MidGray}" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="FindingsContent" Margin="0,9,0,0">
                                    <ItemsControl ItemsSource="{Binding ConflictFindingTexts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource Peach}" FontSize="10"
                                                           TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ToggleButton x:Name="NetworksHeaderToggle" ToolTip="{loc:L TipNetworksHeader}" Style="{StaticResource SidebarFlatToggle}" Padding="13,12,13,0" Click="OnToggleNetworksExpanded"
                                      AutomationProperties.Name="{loc:L Subnets}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:L Subnets}" Foreground="{DynamicResource Subtext}" FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NetworksChevron" Grid.Column="1" Text="&#9662;"
                                           Foreground="{DynamicResource MidGray}" FontSize="9" VerticalAlignment="Center"/>
                            </Grid>
                        </ToggleButton>
                        <StackPanel x:Name="NetworksContent" Margin="0,4,0,0">
                        <TextBlock Text="{loc:L NoNetworks}" Foreground="{DynamicResource MidGray}" FontSize="11"
                                   Margin="13,4,13,10" TextWrapping="Wrap"
                                   Visibility="{Binding IsNetworksEmpty, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding Networks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="13,12" BorderBrush="{DynamicResource Surface}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,9" Cursor="Hand" Background="Transparent"
                                                  Focusable="True" FocusVisualStyle="{StaticResource SidebarRowFocusVisual}"
                                                  KeyDown="OnSidebarRowKeyDown"
                                                  MouseLeftButtonDown="OnRowEditClick" ToolTip="{loc:L TipEditEntry}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                                    <Border Background="{Binding BadgeColor}" CornerRadius="8" Padding="7,2">
                                                        <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Cidr}" Foreground="{DynamicResource Blue}"
                                                               FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="✕" FontSize="12" Cursor="Hand"
                                                           Style="{StaticResource DeleteChipStyle}"
                                                           Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                           MouseLeftButtonDown="OnRowDeleteClick" ToolTip="{loc:L TipRemoveChip}"/>
                                                <!-- No ✕ on the auto-detected network - explain why instead of
                                                     leaving an unexplained gap that reads as a missing feature. -->
                                                <TextBlock Grid.Column="1" Text="🔒" FontSize="10" Foreground="{DynamicResource MidGray}"
                                                           Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}"
                                                           ToolTip="{loc:L TipPrimaryNetworkLocked}" Cursor="Help"/>
                                            </Grid>
                                            <!-- Placeholder for a subnet with no scan result yet -->
                                            <StackPanel Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{loc:L NotScannedYet}" Foreground="{DynamicResource Subtext}"
                                                           FontSize="11" Margin="0,0,0,7"/>
                                                <Button Content="{loc:L ScanNowBtn}" Style="{StaticResource GhostButton}"
                                                        HorizontalAlignment="Left" Click="OnScanSubnetNowClick" ToolTip="{loc:L TipScanSubnetNow}"/>
                                            </StackPanel>
                                            <StackPanel Grid.IsSharedSizeScope="True" Visibility="{Binding IsNotPending, Converter={StaticResource BoolToVis}}">
                                                <!-- Online/offline as the card's headline number - the
                                                     most-read value on the card, readable at a glance. -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                                    <TextBlock Text="{Binding OnlineCount}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Green}"/>
                                                    <TextBlock Text="{Binding OfflineCount, StringFormat=/{0}}" FontSize="13" Foreground="{DynamicResource Subtext}"
                                                               VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                                    <TextBlock Text="{loc:L OnlineOffline}" FontSize="10" Foreground="{DynamicResource MidGray}"
                                                               VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                                                </StackPanel>
                                                <!-- Two-column label/value layout - rows collapse when the
                                                     value wasn't detected (extra subnets); a real Grid per cell since
                                                     a single-cell overlay of two TextBlocks would collide on long
                                                     labels/values. -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="18"/><RowDefinition Height="18"/>
                                                        <RowDefinition Height="18"/><RowDefinition Height="18"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,6,0" Visibility="{Binding HasIp, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CardLblL"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{loc:L OwnIp}" Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Ip, Mode=OneWay}" Foreground="{DynamicResource Text}" FontSize="11" FontWeight="SemiBold"
                                                                 Style="{StaticResource SelectableCardValue}" ToolTip="{loc:L TipCopyValue}"/>
                                                    </Grid>
                                                    <Grid Grid.Row="0" Grid.Column="1" Visibility="{Binding HasGateway, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CardLblR"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{loc:L Gateway}" Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Gateway, Mode=OneWay}" Foreground="{DynamicResource Green}" FontSize="11"
                                                                 Style="{StaticResource SelectableCardValue}" ToolTip="{loc:L TipCopyValue}"/>
                                                    </Grid>
                                                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,6,0" Visibility="{Binding HasMask, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CardLblL"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{loc:L Mask}" Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Text="{Binding SubnetMask, Mode=OneWay}" Foreground="{DynamicResource Text}" FontSize="11"
                                                                 Style="{StaticResource SelectableCardValue}" ToolTip="{loc:L TipCopyValue}"/>
                                                    </Grid>
                                                    <Grid Grid.Row="1" Grid.Column="1" Visibility="{Binding HasDns, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CardLblR"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{loc:L Dns}" Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Text="{Binding DnsShort, Mode=OneWay}" Foreground="{DynamicResource Text}" FontSize="11"
                                                                 Style="{StaticResource SelectableCardValue}" ToolTip="{loc:L TipCopyValue}"/>
                                                    </Grid>
                                                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,6,0" Visibility="{Binding HasMac, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CardLblL"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{loc:L Mac}" Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Mac, Mode=OneWay}" Foreground="{DynamicResource MidGray}" FontSize="11"
                                                                 Style="{StaticResource SelectableCardValue}" ToolTip="{loc:L TipCopyValue}"/>
                                                    </Grid>
                                                    <Grid Grid.Row="2" Grid.Column="1" Visibility="{Binding HasInterface, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CardLblR"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{loc:L Interface}" Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Interface, Mode=OneWay}" Foreground="{DynamicResource Text}" FontSize="11"
                                                                 Style="{StaticResource SelectableCardValue}" ToolTip="{loc:L TipCopyValue}"/>
                                                    </Grid>
                                                    <Grid Grid.Row="3" Grid.Column="0" Margin="0,0,6,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CardLblL"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{loc:L AvgLatency}" Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding AvgLatency}" Foreground="{Binding AvgLatencyColor}" FontSize="11" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Grid>
                                                <!-- The interface's own IPv6 addresses (primary card only), kind-labelled -->
                                                <ItemsControl ItemsSource="{Binding Ipv6Lines}" Margin="0,2,0,0"
                                                              Visibility="{Binding HasIpv6, Converter={StaticResource BoolToVis}}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Height="18" ToolTip="{Binding Tip}">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CardLblV6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <TextBox Grid.Column="1" Text="{Binding Address, Mode=OneWay}" Foreground="{DynamicResource Text}" FontSize="11"
                                                                         Style="{StaticResource SelectableCardValue}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- Adapter picker, only on the auto-detected primary
                                                     card - switching pins scan/ping to that adapter's address. -->
                                                <Grid Margin="0,7,0,0" Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="CardLblP"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{loc:L Interface}" Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="1" FontSize="11" Padding="4,2" ToolTip="{loc:L TipNetworkInterfacePicker}"
                                                              ItemsSource="{Binding DataContext.AvailableInterfaces, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              SelectedValuePath="Ip"
                                                              SelectedValue="{Binding DataContext.SelectedInterfaceIp, RelativeSource={RelativeSource AncestorType=Window}}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </Grid>
                                                <!-- Average-latency history of this network -->
                                                <Grid Margin="0,7,0,0"
                                                      Visibility="{Binding DataContext.NetworkGraphsOn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                    <!-- Not mirrored content even in RTL. -->
                                                    <Canvas Height="38" ClipToBounds="True" SizeChanged="OnNetworkGraphSizeChanged" FlowDirection="LeftToRight">
                                                        <Polyline Points="{Binding GraphPoints}" Stroke="{DynamicResource Green}" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                                                        <TextBlock Text="{Binding GraphMaxText}" Canvas.Left="3" Canvas.Top="0" FontSize="8" Foreground="{DynamicResource MidGray}"/>
                                                        <TextBlock Text="{Binding GraphMinText}" Canvas.Left="3" Canvas.Bottom="0" FontSize="8" Foreground="{DynamicResource MidGray}"/>
                                                        <ItemsControl ItemsSource="{Binding GraphTicks}" Canvas.Left="0" Canvas.Top="0">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                                    <Setter Property="Canvas.Bottom" Value="0"/>
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Label}" FontSize="8" Foreground="{DynamicResource MidGray}" Width="28" TextAlignment="Center"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Canvas>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                        <Border Padding="6,3" Background="Transparent" Cursor="Hand" Tag="False" MouseLeftButtonDown="OnNetworkZoomClick">
                                                            <TextBlock Text="{loc:L ZoomOneMinute}" FontSize="9" Style="{StaticResource ZoomLabelActiveWhenNotZoomed}"/>
                                                        </Border>
                                                        <TextBlock Text=" · " FontSize="9" Foreground="{DynamicResource MidGray}"/>
                                                        <Border Padding="6,3" Background="Transparent" Cursor="Hand" Tag="True" MouseLeftButtonDown="OnNetworkZoomClick">
                                                            <TextBlock Text="{loc:L ZoomThirtySeconds}" FontSize="9" Style="{StaticResource ZoomLabelActiveWhenZoomed}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource SidebarFlatButton}" Padding="13,10" BorderBrush="{DynamicResource Surface}" BorderThickness="0,0,0,1"
                                Click="OnNetworkAddClick" ToolTip="{loc:L TipAddEntry}" AutomationProperties.Name="{loc:L AddNetwork}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="+" FontSize="14" Style="{StaticResource AddRowPlusStyle}"/>
                                <TextBlock Text="{loc:L AddNetwork}" Style="{StaticResource AddRowLabelStyle}"/>
                            </StackPanel>
                        </Button>
                        </StackPanel>

                        <!-- Pinned IPs -->
                        <Border Padding="13,12" BorderBrush="{DynamicResource Surface}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <ToggleButton x:Name="PinnedHeaderToggle" Style="{StaticResource SidebarFlatToggle}" Click="OnTogglePinnedExpanded" ToolTip="{loc:L TipPinnedIps}"
                                              AutomationProperties.Name="{loc:L PinnedIps}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:L PinnedIps}" Foreground="{DynamicResource Subtext}" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PinnedChevron" Grid.Column="1" Text="&#9662;"
                                                   Foreground="{DynamicResource MidGray}" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="PinnedContent" Margin="0,7,0,0">
                                <TextBlock Text="{loc:L NoPinnedIps}" Foreground="{DynamicResource MidGray}" FontSize="11" Margin="0,0,0,7" TextWrapping="Wrap"
                                           Visibility="{Binding IsPinnedEmpty, Converter={StaticResource BoolToVis}}"/>
                                <ItemsControl ItemsSource="{Binding PinnedEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3" Cursor="Hand" Background="Transparent"
                                                  Focusable="True" FocusVisualStyle="{StaticResource SidebarRowFocusVisual}"
                                                  KeyDown="OnSidebarRowKeyDown"
                                                  MouseLeftButtonDown="OnRowEditClick" ToolTip="{loc:L TipEditEntry}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding SwatchColor}"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="1" IsHitTestVisible="False">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Text}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Ip}" Foreground="{DynamicResource MidGray}" FontSize="9"
                                                               Visibility="{Binding HasCustomName, Converter={StaticResource BoolToVis}}"/>
                                                    <!-- A pinned hostname that failed to resolve this run. -->
                                                    <TextBlock Text="{loc:L PinnedCannotResolve}" Foreground="{DynamicResource Peach}" FontSize="9"
                                                               Visibility="{Binding IsUnresolved, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="✕" FontSize="11" Cursor="Hand" VerticalAlignment="Center"
                                                           Style="{StaticResource DeleteChipStyle}"
                                                           MouseLeftButtonDown="OnRowDeleteClick" ToolTip="{loc:L TipRemoveChip}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource SidebarFlatButton}" Padding="0,7,0,0" Click="OnPinnedAddClick" ToolTip="{loc:L TipAddEntry}"
                                        AutomationProperties.Name="{loc:L AddPinnedIp}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="+" FontSize="13" Style="{StaticResource AddRowPlusStyle}"/>
                                        <TextBlock Text="{loc:L AddPinnedIp}" Style="{StaticResource AddRowLabelStyle}"/>
                                    </StackPanel>
                                </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Internet latency -->
                        <Border Padding="13,12" BorderBrush="{DynamicResource Surface}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <ToggleButton x:Name="InternetHeaderToggle" ToolTip="{loc:L TipInternetHeader}" Style="{StaticResource SidebarFlatToggle}" Click="OnToggleInternetExpanded"
                                              AutomationProperties.Name="{loc:L InternetLatency}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:L InternetLatency}" Foreground="{DynamicResource Subtext}" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="InternetChevron" Grid.Column="1" Text="&#9662;"
                                                   Foreground="{DynamicResource MidGray}" FontSize="9" VerticalAlignment="Center"/>
                                    </Grid>
                                </ToggleButton>
                                <StackPanel x:Name="InternetContent" Margin="0,7,0,0">
                                <TextBlock Text="{loc:L NoInternetHosts}" Foreground="{DynamicResource MidGray}" FontSize="11" Margin="0,0,0,7" TextWrapping="Wrap"
                                           Visibility="{Binding IsInternetHostsEmpty, Converter={StaticResource BoolToVis}}"/>
                                <!-- Header row, columns match the item template below -->
                                <Grid Margin="0,0,0,3" Visibility="{Binding HasInternetHosts, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/><ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="52"/><ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="14"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="{loc:L Avg}" Foreground="{DynamicResource MidGray}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{loc:L Min}" Foreground="{DynamicResource MidGray}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{loc:L Max}" Foreground="{DynamicResource MidGray}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{loc:L Last}" Foreground="{DynamicResource MidGray}" FontSize="10" HorizontalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding InternetHosts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" Cursor="Hand" Background="Transparent"
                                                  Focusable="True" FocusVisualStyle="{StaticResource SidebarRowFocusVisual}"
                                                  KeyDown="OnSidebarRowKeyDown"
                                                  MouseLeftButtonDown="OnRowEditClick" ToolTip="{loc:L TipEditEntry}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="52"/><ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="52"/><ColumnDefinition Width="52"/>
                                                    <ColumnDefinition Width="14"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Subtext}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="1" Text="{Binding AvgDisplay}" Foreground="{Binding AvgColor}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding MinDisplay}" Foreground="{Binding MinColor}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding MaxDisplay}" Foreground="{Binding MaxColor}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding LastDisplay}" Foreground="{Binding LastColor}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="✕" FontSize="10" Cursor="Hand" VerticalAlignment="Center"
                                                           Style="{StaticResource DeleteChipStyle}"
                                                           MouseLeftButtonDown="OnRowDeleteClick" ToolTip="{loc:L TipRemoveChip}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource SidebarFlatButton}" Padding="0,7,0,0" Click="OnHostAddClick" ToolTip="{loc:L TipAddEntry}"
                                        AutomationProperties.Name="{loc:L AddHost}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="+" FontSize="13" Style="{StaticResource AddRowPlusStyle}"/>
                                        <TextBlock Text="{loc:L AddHost}" Style="{StaticResource AddRowLabelStyle}"/>
                                    </StackPanel>
                                </Button>
                                <!-- Totals: avg of averages/last pings, extreme min/max -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/><ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="52"/><ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:L TotalLabel}" Foreground="{DynamicResource Mauve}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding InternetTotalAvg}" Foreground="{Binding InternetTotalAvgColor}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding InternetTotalMin}" Foreground="{Binding InternetTotalMinColor}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding InternetTotalMax}" Foreground="{Binding InternetTotalMaxColor}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding InternetTotalLast}" Foreground="{Binding InternetTotalLastColor}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Small history graph of the overall internet average -->
                                <StackPanel x:Name="InetGraphSection">
                                    <Grid Margin="0,7,0,0">
                                        <!-- Not mirrored content even in RTL. -->
                                        <Canvas x:Name="InetGraphCanvas" Height="38" ClipToBounds="True"
                                                SizeChanged="OnGraphSizeChanged" FlowDirection="LeftToRight">
                                            <Polyline x:Name="InetGraphLine" Stroke="{DynamicResource Blue}" StrokeThickness="1.2"
                                                      StrokeLineJoin="Round"/>
                                            <TextBlock x:Name="InetGraphMaxText" Canvas.Left="3" Canvas.Top="0" FontSize="8"
                                                       Foreground="{DynamicResource MidGray}"/>
                                            <TextBlock x:Name="InetGraphMinText" Canvas.Left="3" Canvas.Bottom="0" FontSize="8"
                                                       Foreground="{DynamicResource MidGray}"/>
                                        </Canvas>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Border Padding="6,3" Background="Transparent" Cursor="Hand" Tag="False" MouseLeftButtonDown="OnInetZoomClick">
                                                <TextBlock Text="{loc:L ZoomOneMinute}" FontSize="9" Style="{StaticResource ZoomLabelActiveWhenNotZoomed}"/>
                                            </Border>
                                            <TextBlock Text=" · " FontSize="9" Foreground="{DynamicResource MidGray}"/>
                                            <Border Padding="6,3" Background="Transparent" Cursor="Hand" Tag="True" MouseLeftButtonDown="OnInetZoomClick">
                                                <TextBlock Text="{loc:L ZoomThirtySeconds}" FontSize="9" Style="{StaticResource ZoomLabelActiveWhenZoomed}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        </Grid>
        </ScrollViewer>

        <!-- ══ Notice banner: undo hint after removing a sidebar entry (Networks/Pinned
             IPs/Internet hosts) - sits in the same cell as the main content,
             bottom-center, on top since it's declared after it. ══ -->
        <Border x:Name="NoticeBanner" Grid.Row="1" Visibility="Collapsed"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18"
                Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource Surface}"
                BorderThickness="1" CornerRadius="9" Padding="14,9">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NoticeText" FontSize="12" Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="520"/>
                <Button x:Name="NoticeActionBtn" ToolTip="{loc:L TipNoticeAction}" Style="{StaticResource GhostButton}" FontSize="12"
                        Padding="8,3" Margin="12,0,0,0" Click="OnNoticeAction"/>
            </StackPanel>
        </Border>

        <!-- ══ Color picker for the legend squares ══ -->
        <Popup x:Name="ColorPickerPopup" StaysOpen="True" AllowsTransparency="True"
               Placement="Bottom" VerticalOffset="6" PopupAnimation="Fade">
            <Border Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource Surface}"
                    BorderThickness="1" CornerRadius="9" Padding="12">
                <StackPanel>
                    <UniformGrid x:Name="SwatchPanel" Columns="5" HorizontalAlignment="Left"/>
                    <DockPanel Margin="0,10,0,0">
                        <Border x:Name="HexPreview" Width="26" Height="26" CornerRadius="6"
                                BorderBrush="{DynamicResource Surface2}" BorderThickness="1"
                                Background="{DynamicResource Surface}" VerticalAlignment="Center"/>
                        <Button x:Name="ApplyColorBtn" ToolTip="{loc:L TipColorApply}" DockPanel.Dock="Right" Content="{loc:L Ok}"
                                Style="{StaticResource AccentButton}" Padding="12,5" Margin="8,0,0,0"
                                Click="OnHexColorApply"/>
                        <Button x:Name="PickerResetBtn" DockPanel.Dock="Right" Content="✕"
                                Style="{StaticResource GhostButton}" Padding="10,5" Margin="8,0,0,0"
                                Click="OnPickerReset" Visibility="Collapsed"
                                ToolTip="{loc:L TipResetValue}" AutomationProperties.Name="{loc:L TipResetValue}"/>
                        <TextBox x:Name="HexBox" ToolTip="{loc:L TipHexBox}" Margin="8,0,0,0" VerticalAlignment="Center"
                                 FontSize="12" MaxLength="7" TextChanged="OnHexColorChanged"
                                 KeyDown="OnHexColorKeyDown"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ══ Cell edit popup (hostname / group, opened by double-click) ══ -->
        <Popup x:Name="CellEditPopup" StaysOpen="True" AllowsTransparency="True"
               Placement="Bottom" VerticalOffset="4" PopupAnimation="Fade">
            <Border Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource Surface}"
                    BorderThickness="1" CornerRadius="9" Padding="10">
                <DockPanel>
                    <Button x:Name="CellEditResetBtn" DockPanel.Dock="Right" Content="✕"
                            Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0"
                            Click="OnCellEditReset" ToolTip="{loc:L TipResetValue}" AutomationProperties.Name="{loc:L TipResetValue}"/>
                    <Button DockPanel.Dock="Right" Content="{loc:L Ok}"
                            Style="{StaticResource AccentButton}" Padding="12,5" Margin="8,0,0,0"
                            Click="OnCellEditOk" ToolTip="{loc:L TipCellEditOk}"/>
                    <TextBox x:Name="CellEditBox" ToolTip="{loc:L TipCellEditBox}" MinWidth="170" FontSize="13" VerticalAlignment="Center"
                             KeyDown="OnCellEditKey"/>
                </DockPanel>
            </Border>
        </Popup>

        <!-- ══ Add/edit popup for Networks, Pinned IPs and Internet hosts ══ -->
        <Popup x:Name="EntryEditPopup" StaysOpen="True" AllowsTransparency="True"
               Placement="Bottom" VerticalOffset="4" PopupAnimation="Fade">
            <Border Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource Surface}"
                    BorderThickness="1" CornerRadius="9" Padding="12" MinWidth="230" PreviewKeyDown="OnEntryEditPreviewKey">
                <StackPanel>
                    <TextBlock x:Name="EntryEditTitle" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource Mauve}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="EntryEditTargetLabel" FontSize="10" Foreground="{DynamicResource Subtext}" Margin="0,0,0,3"/>
                    <DockPanel Margin="0,0,0,6">
                        <Border x:Name="EntryEditColorBtn" DockPanel.Dock="Right" Width="26" Height="26" CornerRadius="6" Margin="6,0,0,0"
                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Surface2}" BorderThickness="1"
                                Cursor="Hand" MouseLeftButtonDown="OnEntryEditColorClick" ToolTip="{loc:L TipChipColor}"/>
                        <TextBox x:Name="EntryEditTargetBox" ToolTip="{loc:L TipEntryTarget}" FontSize="13" KeyDown="OnEntryEditKey"/>
                    </DockPanel>
                    <TextBlock Text="{loc:L NamePlaceholder}" FontSize="10" Foreground="{DynamicResource Subtext}" Margin="0,0,0,3"/>
                    <TextBox x:Name="EntryEditNameBox" ToolTip="{loc:L TipEntryName}" FontSize="13" Margin="0,0,0,4" KeyDown="OnEntryEditKey" TextChanged="OnEntryEditNameChanged"/>
                    <TextBlock x:Name="EntryEditNameHint" Foreground="{DynamicResource Peach}" FontSize="11" Visibility="Collapsed" Margin="0,3,0,0"
                               Text="{loc:L DuplicateName}"/>
                    <TextBlock x:Name="EntryEditError" Foreground="{DynamicResource Red}" FontSize="11" Visibility="Collapsed" Margin="0,3,0,0"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="EntryEditDeleteBtn" ToolTip="{loc:L TipEntryDelete}" Content="{loc:L TipRemoveChip}" Style="{StaticResource GhostButton}"
                                Padding="10,5" HorizontalAlignment="Left" Click="OnEntryEditDelete" Visibility="Collapsed"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:L Close}" Style="{StaticResource GhostButton}" Padding="10,5" Click="OnEntryEditCancel" ToolTip="{loc:L TipEditClose}"/>
                            <Button Content="{loc:L Ok}" Style="{StaticResource AccentButton}" Padding="14,5" Margin="6,0,0,0" Click="OnEntryEditSave" ToolTip="{loc:L TipEditSave}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Add/rename/delete a profile (add mode has no delete button). -->
        <Popup x:Name="ProfileEditPopup" StaysOpen="True" AllowsTransparency="True"
               Placement="Bottom" VerticalOffset="4" PopupAnimation="Fade">
            <Border Background="{DynamicResource BgDark}" BorderBrush="{DynamicResource Surface}"
                    BorderThickness="1" CornerRadius="9" Padding="12" MinWidth="220" PreviewKeyDown="OnProfileEditPreviewKey">
                <StackPanel>
                    <TextBlock x:Name="ProfileEditTitle" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource Mauve}" Margin="0,0,0,8"/>
                    <TextBox x:Name="ProfileEditNameBox" ToolTip="{loc:L TipProfileName}" FontSize="13" KeyDown="OnProfileEditKey"/>
                    <TextBlock x:Name="ProfileEditError" Foreground="{DynamicResource Red}" FontSize="11" Visibility="Collapsed" Margin="0,3,0,0"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ProfileEditDeleteBtn" ToolTip="{loc:L TipProfileDelete}" Content="{loc:L TipRemoveChip}" Style="{StaticResource GhostButton}"
                                Padding="10,5" HorizontalAlignment="Left" Click="OnProfileEditDelete" Visibility="Collapsed"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:L Close}" Style="{StaticResource GhostButton}" Padding="10,5" Click="OnProfileEditCancel" ToolTip="{loc:L TipEditClose}"/>
                            <Button Content="{loc:L Ok}" Style="{StaticResource AccentButton}" Padding="14,5" Margin="6,0,0,0" Click="OnProfileEditSave" ToolTip="{loc:L TipEditSave}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ══ Embedded settings overlay (single page) ══ -->
        <Grid x:Name="SettingsOverlay" Grid.Row="1" Visibility="Collapsed" IsVisibleChanged="OnOtherPageVisibleChanged"
              Background="{DynamicResource OverlayDim}" MouseLeftButtonDown="OnOverlayBackgroundClick">
            <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Surface}" BorderThickness="1"
                    CornerRadius="10" Margin="40" MaxWidth="840">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="22,22,22,14">
                        <!-- Explicit columns: with
                             both children sharing one cell, a narrow window let the title's
                             rendered width invade the right-hand controls' space and overlap
                             them. Column 0 (*) absorbs the shrink via ellipsis instead. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:L Settings}" Foreground="{DynamicResource Mauve}" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                        <Grid Grid.Column="1" HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ComboBox x:Name="LanguageBox" MinWidth="140" Height="32" VerticalAlignment="Center" Margin="0,2,0,2"
                                          SelectionChanged="OnLanguageChanged" ToolTip="{loc:L TipLanguage}"/>
                                <Button x:Name="ResetButton" Content="{loc:L ResetDefaults}" Click="OnResetDefaults" Style="{StaticResource GhostButton}" Padding="14,7" Margin="10,2,0,2" ToolTip="{loc:L TipResetDefaults}"/>
                            </WrapPanel>
                            <Button Grid.Column="1" VerticalAlignment="Top" Content="{loc:L Close}" Click="OnSettingsCancel" ToolTip="{loc:L TipSettingsClose}" Style="{StaticResource AccentButton}" Padding="18,7" Margin="8,2,0,2"/>
                        </Grid>
                    </Grid>
                    <DockPanel>
                        <!-- Left category list; a single long page would no longer fit all the settings. -->
                        <ListBox x:Name="SettingsNavList" DockPanel.Dock="Left" MinWidth="150" Margin="14,0,4,14"
                                 Style="{StaticResource SettingsNavList}" ItemContainerStyle="{StaticResource SettingsNavItem}"
                                 SelectionChanged="OnSettingsNavChanged">
                            <ListBoxItem Tag="Scan" ToolTip="{loc:L TipNavScan}"><TextBlock Text="{loc:L NavScan}" Style="{StaticResource SettingsNavLabel}"/></ListBoxItem>
                            <ListBoxItem Tag="Display" ToolTip="{loc:L TipNavDisplay}"><TextBlock Text="{loc:L NavDisplay}" Style="{StaticResource SettingsNavLabel}"/></ListBoxItem>
                            <ListBoxItem Tag="Internet" ToolTip="{loc:L TipNavInternet}"><TextBlock Text="{loc:L TabInternet}" Style="{StaticResource SettingsNavLabel}"/></ListBoxItem>
                            <ListBoxItem Tag="Graphs" ToolTip="{loc:L TipNavGraphs}"><TextBlock Text="{loc:L TabGraphs}" Style="{StaticResource SettingsNavLabel}"/></ListBoxItem>
                            <ListBoxItem Tag="Data" ToolTip="{loc:L TipNavData}"><TextBlock Text="{loc:L NavData}" Style="{StaticResource SettingsNavLabel}"/></ListBoxItem>
                            <ListBoxItem Tag="App" ToolTip="{loc:L TipNavApp}"><TextBlock Text="{loc:L TabApp}" Style="{StaticResource SettingsNavLabel}"/></ListBoxItem>
                            <ListBoxItem Tag="About" ToolTip="{loc:L TipNavAbout}"><TextBlock Text="{loc:L NavAbout}" Style="{StaticResource SettingsNavLabel}"/></ListBoxItem>
                            <ListBoxItem Tag="Help" ToolTip="{loc:L TipNavHelp}"><TextBlock Text="{loc:L NavHelp}" Style="{StaticResource SettingsNavLabel}"/></ListBoxItem>
                        </ListBox>
                        <Border DockPanel.Dock="Left" Width="1" Background="{DynamicResource Surface}" Margin="0,0,0,14"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid Margin="18,0,22,22">
                                <!-- Scan -->
                                <StackPanel x:Name="ScanPage" Visibility="Collapsed">
                                    <!-- Two columns to save height; inputs right, labels left. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Right-aligned numbers with a fixed (read-only) unit suffix. -->
                                        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,5" ToolTip="{loc:L TipScanThreads}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight">
                                                <CheckBox x:Name="UnlimitedThreadsBox" Content="{loc:L UnlimitedThreadsLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" Checked="OnUnlimitedThreadsChanged" Unchecked="OnUnlimitedThreadsChanged"/>
                                                <TextBox x:Name="ScanThreadsBox" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Style="{StaticResource SettingUnitLabel}"/>
                                            </StackPanel>
                                            <TextBlock Text="{loc:L ScanThreads}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,5" ToolTip="{loc:L TipPingInterval}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="IntervalBox" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Text="ms" Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L PingInterval}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel Grid.Row="2" Grid.Column="0" Margin="0,5" ToolTip="{loc:L TipOfflineAfter}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="OfflineAfterBox" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L OfflineAfter}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel Grid.Row="3" Grid.Column="0" Margin="0,5" ToolTip="{loc:L TipOfflineRecheck}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><CheckBox x:Name="OfflineRecheckOffBox" Content="{loc:L OffLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" Checked="OnOfflineRecheckOffChanged" Unchecked="OnOfflineRecheckOffChanged"/><TextBox x:Name="OfflineRecheckBox" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L OfflineRecheck}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                    </Grid>
                                    <TextBlock Text="{loc:L ScanComfortLabel}" Foreground="{DynamicResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,17,0,8"/>
                                    <DockPanel Margin="0,5" ToolTip="{loc:L TipRepeatScan}">
                                        <ComboBox x:Name="RepeatScanBox" DockPanel.Dock="Right" Style="{StaticResource SettingValueCombo}"
                                                  SelectionChanged="OnSettingChanged"/>
                                        <TextBlock Text="{loc:L RepeatScanLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <CheckBox x:Name="NotifyScanDoneBox" Content="{loc:L NotifyScanDoneLabel}" Foreground="{DynamicResource Text}" FontSize="13"
                                              Margin="0,8,0,0" ToolTip="{loc:L TipNotifyScanDone}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    <CheckBox x:Name="NotifyNewDeviceBox" Content="{loc:L NotifyNewDeviceLabel}" Foreground="{DynamicResource Text}" FontSize="13"
                                              Margin="0,8,0,0" ToolTip="{loc:L TipNotifyNewDevice}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    <CheckBox x:Name="StartMinimizedBox" Content="{loc:L StartMinimizedLabel}" Foreground="{DynamicResource Text}" FontSize="13"
                                              Margin="0,8,0,0" ToolTip="{loc:L TipStartMinimized}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                                    <TextBlock Text="{loc:L ScanPresetsHeader}" Foreground="{DynamicResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,17,0,0"/>
                                    <TextBlock Text="{loc:L ScanPresetLabel}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,8,0,4"/>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <ComboBox x:Name="ScanPresetBox" MinWidth="180" Height="32" ToolTip="{loc:L TipScanPreset}" SelectionChanged="OnScanPresetChanged"/>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <ctrl:WarningMark x:Name="PresetWarn" VerticalAlignment="Center" Visibility="Collapsed"/>
                                            <Button x:Name="PresetSaveBtn" Content="{loc:L PresetSaveButton}" ToolTip="{loc:L TipPresetSave}"
                                                    Style="{StaticResource GhostButton}" Padding="10,5" Margin="8,0,0,0" Click="OnPresetSaveStart"/>
                                            <Button x:Name="PresetDeleteBtn" Content="{loc:L PresetDeleteButton}" ToolTip="{loc:L TipPresetDelete}"
                                                    Style="{StaticResource GhostButton}" Padding="10,5" Margin="6,0,0,0" Click="OnPresetDelete"/>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel x:Name="PresetNamePanel" Visibility="Collapsed" Margin="0,8,0,0">
                                        <TextBlock Text="{loc:L PresetNameLabel}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PresetNameBox" FontSize="13" MaxLength="40" ToolTip="{loc:L TipPresetName}" KeyDown="OnPresetNameKey"/>
                                        <TextBlock x:Name="PresetNameError" Foreground="{DynamicResource Red}" FontSize="11" Visibility="Collapsed" TextWrapping="Wrap" Margin="2,3,0,0"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <Button Content="{loc:L Close}" Style="{StaticResource GhostButton}" Padding="10,5" Click="OnPresetSaveCancel" ToolTip="{loc:L TipEditClose}"/>
                                            <Button Content="{loc:L Ok}" Style="{StaticResource AccentButton}" Padding="14,5" Margin="6,0,0,0" Click="OnPresetSaveConfirm" ToolTip="{loc:L TipEditSave}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <CheckBox x:Name="ExportPortsBox" Content="{loc:L ExportPortsLabel}" Foreground="{DynamicResource Text}" FontSize="13"
                                              Margin="0,12,0,0" ToolTip="{loc:L TipExportPorts}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    <TextBlock Text="{loc:L ScanPortsLabel}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,8,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ScanPortsModeBox" Height="32" ToolTip="{loc:L TipScanPorts}" SelectionChanged="OnScanPortsModeChanged"/>
                                        <ctrl:WarningMark x:Name="PortsAllWarn" Grid.Column="1" Margin="8,0,0,0" Visibility="Collapsed" ToolTip="{loc:L WarnFullRange}"/>
                                    </Grid>
                                    <TextBox x:Name="ScanPortsListBox" FontSize="13" Margin="0,6,0,0" Visibility="Collapsed" ToolTip="{loc:L TipScanPortsList}" TextChanged="OnScanPortsListChanged"/>
                                    <TextBlock x:Name="ScanPortsError" Foreground="{DynamicResource Red}" FontSize="11" Visibility="Collapsed" TextWrapping="Wrap" Margin="2,3,0,0"/>
                                    <CheckBox x:Name="ServiceDetectionBox" Content="{loc:L ServiceDetectionLabel}" Foreground="{DynamicResource Text}" FontSize="13"
                                              Margin="0,8,0,0" ToolTip="{loc:L TipServiceDetection}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    <TextBlock Text="{loc:L PresetCommandLabel}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,12,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PresetCommandBox" FontSize="12" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" ToolTip="{loc:L TipPresetCommand}"/>
                                        <Button Grid.Column="1" Content="{loc:L CopyCommandButton}" ToolTip="{loc:L TipCopyCommand}"
                                                Style="{StaticResource GhostButton}" Padding="10,5" Margin="8,0,0,0" VerticalAlignment="Top" Click="OnCopyPresetCommand"/>
                                    </Grid>

                                    <TextBlock Text="{loc:L DiscoveryHeader}" Foreground="{DynamicResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,17,0,0"/>
                                    <StackPanel x:Name="DiscoveryModesPanel" Margin="0,6,0,0"/>
                                    <TextBlock Text="{loc:L TcpPingPortsLabel}" Foreground="{DynamicResource Text}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,4"/>
                                    <TextBox x:Name="TcpPingPortsBox" FontSize="13" ToolTip="{loc:L TipTcpPingPorts}" TextChanged="OnSettingChanged"/>
                                    <TextBlock Text="{loc:L UdpPingPortsLabel}" Foreground="{DynamicResource Text}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,4"/>
                                    <TextBox x:Name="UdpPingPortsBox" FontSize="13" ToolTip="{loc:L TipUdpPingPorts}" TextChanged="OnSettingChanged"/>
                                    <CheckBox x:Name="OsFingerprintBox" Content="{loc:L OsFingerprintLabel}" Foreground="{DynamicResource Text}" FontSize="13"
                                              Margin="0,8,0,0" ToolTip="{loc:L TipOsFingerprint}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    <TextBlock x:Name="OsFingerprintNote" Text="{loc:L OsFingerprintDegradeNote}" Foreground="{DynamicResource Subtext}" FontSize="12" TextWrapping="Wrap" Margin="22,2,0,0"/>

                                    <!-- Advanced network settings behind an expander, so the
                                         normal Scan page stays lean for everyone who never needs these. -->
                                    <ToggleButton x:Name="AdvancedNetworkToggle" ToolTip="{loc:L TipAdvancedNetwork}" Style="{StaticResource SidebarFlatToggle}" Click="OnToggleAdvancedNetwork" Margin="0,17,0,0"
                                          AutomationProperties.Name="{loc:L AdvancedNetworkLabel}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:L AdvancedNetworkLabel}" Foreground="{DynamicResource Blue}" FontWeight="Bold" FontSize="15"/>
                                            <TextBlock x:Name="AdvancedNetworkChevron" Grid.Column="1" Text="&#9656;"
                                                       Foreground="{DynamicResource MidGray}" FontSize="12" VerticalAlignment="Center"/>
                                        </Grid>
                                    </ToggleButton>
                                    <StackPanel x:Name="AdvancedNetworkContent" Visibility="Collapsed" Margin="0,10,0,0">
                                        <DockPanel Margin="0,0,0,2" ToolTip="{loc:L TipPortScanTiming}">
                                            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SettingValueGutter}"><TextBlock x:Name="PortScanTimingName" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" MinWidth="70" TextAlignment="Right"/></Border>
                                            <ctrl:WarningMark x:Name="PortScanTimingWarn" DockPanel.Dock="Right" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="{loc:L WarnFastTiming}"/>
                                            <TextBlock Text="{loc:L PortScanTimingLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <Slider x:Name="PortScanTimingSlider" Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Margin="0,0,0,2" ToolTip="{loc:L TipPortScanTiming}" ValueChanged="OnPortScanTimingChanged"/>
                                        <TextBlock x:Name="PortScanTimingSummary" Foreground="{DynamicResource Subtext}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" ToolTip="{loc:L TipPortScanTiming}"/>
                                        <DockPanel Margin="0,5" ToolTip="{loc:L TipPortScanConnectTimeout}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="PortScanConnectTimeoutBox" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Text="ms" Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L PortScanConnectTimeoutLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,5" ToolTip="{loc:L TipPortScanBannerTimeout}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="PortScanBannerTimeoutBox" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Text="ms" Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L PortScanBannerTimeoutLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,5" ToolTip="{loc:L TipPortScanParallelism}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="PortScanParallelismBox" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L PortScanParallelismLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,5" ToolTip="{loc:L TipPortScanRetries}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="PortScanRetriesBox" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L PortScanRetriesLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,5" ToolTip="{loc:L TipPortScanDelay}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="PortScanDelayBox" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Text="ms" Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L PortScanDelayLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,5" ToolTip="{loc:L TipPortScanMaxRate}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="PortScanMaxRateBox" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Text="/s" Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L PortScanMaxRateLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,5" ToolTip="{loc:L TipPortScanIntensity}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="PortScanIntensityBox" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" ToolTip="{loc:L TipPortScanIntensity}" TextChanged="OnSettingChanged"/><TextBlock Text="0-9" Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L PortScanIntensityLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                        <TextBlock Text="{loc:L SnmpCommunityLabel}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,10,0,4" ToolTip="{loc:L TipSnmpCommunity}"/>
                                        <TextBox x:Name="SnmpCommunityBox" FontSize="13" ToolTip="{loc:L TipSnmpCommunity}" TextChanged="OnSettingChanged"/>
                                        <TextBlock Text="{loc:L CustomPortsLabel}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,10,0,4" ToolTip="{loc:L TipCustomPorts}"/>
                                        <TextBox x:Name="CustomPortsBox" FontSize="13" ToolTip="{loc:L TipCustomPorts}" TextChanged="OnSettingChanged"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Anzeige / Display -->
                                <StackPanel x:Name="DisplayPage" Visibility="Collapsed">
                                    <DockPanel Margin="0,5" ToolTip="{loc:L TipTheme}">
                                        <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" Style="{StaticResource SettingValueCombo}"
                                                  SelectionChanged="OnThemeChanged" AutomationProperties.Name="{loc:L ColorScheme}"/>
                                        <TextBlock Text="{loc:L ColorScheme}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,5" ToolTip="{loc:L TipTextScale}">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="UiScaleBox" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged" LostFocus="OnUiScaleCommit"/><TextBlock Text="%" Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                        <TextBlock Text="{loc:L TextScale}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,5" ToolTip="{loc:L TipAccentColor}">
                                        <Border x:Name="AccentColorSwatch" DockPanel.Dock="Right" Width="24" Height="24" Style="{StaticResource SettingValueGutterTall}" CornerRadius="6"
                                                BorderBrush="{DynamicResource Surface2}" BorderThickness="1" Cursor="Hand"
                                                MouseLeftButtonDown="OnAccentColorClick"/>
                                        <TextBlock Text="{loc:L AccentColorLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,5" ToolTip="{loc:L TipDateNumberFormat}">
                                        <ComboBox x:Name="DateFormatBox" DockPanel.Dock="Right" Style="{StaticResource SettingValueCombo}"
                                                  SelectionChanged="OnDateFormatChanged"/>
                                        <TextBlock Text="{loc:L DateNumberFormatLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <CheckBox x:Name="CompactRowsBox" Content="{loc:L CompactRowsLabel}" Foreground="{DynamicResource Text}" FontSize="13"
                                              Margin="0,12,0,0" ToolTip="{loc:L TipCompactRows}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    <CheckBox x:Name="ShowSkippedLegendBox" Content="{loc:L ShowSkippedLegendLabel}" Foreground="{DynamicResource Text}" FontSize="13"
                                              Margin="0,8,0,0" ToolTip="{loc:L TipShowSkippedLegend}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    <TextBlock Text="{loc:L ColumnsLabel}" Foreground="{DynamicResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,17,0,8"
                                               ToolTip="{loc:L TipColumns}"/>
                                    <UniformGrid Columns="3">
                                        <CheckBox x:Name="GroupColBox" ToolTip="{loc:L TipColGroup}" Content="{loc:L Group}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                        <CheckBox x:Name="AvgColBox" ToolTip="{loc:L TipColAvg}" Content="{loc:L Avg}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                        <CheckBox x:Name="MinColBox" ToolTip="{loc:L TipColMin}" Content="{loc:L Min}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                        <CheckBox x:Name="MaxColBox" ToolTip="{loc:L TipColMax}" Content="{loc:L Max}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                        <CheckBox x:Name="LastColBox" ToolTip="{loc:L TipColLast}" Content="{loc:L Last}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                        <CheckBox x:Name="LossColBox" ToolTip="{loc:L TipColLoss}" Content="{loc:L Loss}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                        <CheckBox x:Name="JitterColBox" ToolTip="{loc:L TipColJitter}" Content="{loc:L Jitter}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                        <CheckBox x:Name="ProgressColBox" ToolTip="{loc:L TipColProgress}" Content="{loc:L Progress}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                        <CheckBox x:Name="MacColBox" ToolTip="{loc:L TipColMac}" Content="{loc:L Mac}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                        <CheckBox x:Name="VendorColBox" ToolTip="{loc:L TipColVendor}" Content="{loc:L Vendor}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                        <CheckBox x:Name="PortsColBox" ToolTip="{loc:L TipColPorts}" Content="{loc:L ColPorts}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                        <CheckBox x:Name="MethodColBox" ToolTip="{loc:L TipColMethod}" Content="{loc:L FoundBy}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                        <CheckBox x:Name="OsColBox" ToolTip="{loc:L TipColOs}" Content="{loc:L OsColumnHeader}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                        <CheckBox x:Name="FirstSeenColBox" ToolTip="{loc:L TipColFirstSeen}" Content="{loc:L ColFirstSeen}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                        <CheckBox x:Name="LastSeenColBox" ToolTip="{loc:L TipColLastSeen}" Content="{loc:L ColLastSeen}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,16,6" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/>
                                    </UniformGrid>
                                    <TextBlock Text="{loc:L TabLatencyColors}" Foreground="{DynamicResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,17,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,5" ToolTip="{loc:L TipHeatMs1}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="HeatMs1Box" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Text="ms" Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L HeatMs1}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                                        </DockPanel>
                                        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,5" ToolTip="{loc:L TipHeatMs2}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="HeatMs2Box" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Text="ms" Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L HeatMs2}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                                        </DockPanel>
                                        <DockPanel Grid.Row="2" Grid.Column="0" Margin="0,5" ToolTip="{loc:L TipHeatMs3}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="HeatMs3Box" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Text="ms" Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L HeatMs3}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                                        </DockPanel>
                                        <DockPanel Grid.Row="3" Grid.Column="0" Margin="0,5" ToolTip="{loc:L TipHeatMs4}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="HeatMs4Box" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Text="ms" Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L HeatMs4}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0"/>
                                        </DockPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Rectangle Width="30" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource Green}"/>
                                        <Rectangle Width="30" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource Lime}" Margin="3,0,0,0"/>
                                        <Rectangle Width="30" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource Yellow}" Margin="3,0,0,0"/>
                                        <Rectangle Width="30" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource Peach}" Margin="3,0,0,0"/>
                                        <Rectangle Width="30" Height="14" RadiusX="3" RadiusY="3" Fill="{DynamicResource Red}" Margin="3,0,0,0"/>
                                        <Button Content="{loc:L ResetHeatDefaults}" Click="OnResetHeatDefaults" Style="{StaticResource GhostButton}" Padding="10,4" Margin="14,0,0,0" ToolTip="{loc:L TipResetHeatDefaults}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="HeatOrderHint" Text="{loc:L HeatOrderCorrected}" Foreground="{DynamicResource Peach}" FontSize="11" Visibility="Collapsed" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Internet -->
                                <StackPanel x:Name="InternetPage" Visibility="Collapsed">
                                    <CheckBox x:Name="EnableInternetBox" Content="{loc:L EnableInternet}" Foreground="{DynamicResource Text}" FontSize="13" ToolTip="{loc:L TipEnableInternet}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    <DockPanel Margin="0,10,0,5" ToolTip="{loc:L TipInternetTimeout}">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="InternetTimeoutBox" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Text="ms" Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                        <TextBlock Text="{loc:L InternetTimeout}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    </DockPanel>
                                </StackPanel>

                                <!-- Grafiken / Graphs -->
                                <StackPanel x:Name="GraphsPage" Visibility="Collapsed">
                                    <StackPanel>
                                        <StackPanel>
                                            <CheckBox x:Name="GraphsEnabledBox" Content="{loc:L EnableGraphs}" Foreground="{DynamicResource Text}" FontSize="13"
                                                      ToolTip="{loc:L TipEnableGraphs}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                            <CheckBox x:Name="NetworkGraphsBox" Content="{loc:L EnableNetworkGraphs}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,8,0,0"
                                                      ToolTip="{loc:L TipEnableNetworkGraphs}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                            <CheckBox x:Name="AutoGraphPinnedBox" Content="{loc:L AutoGraphPinned}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,8,0,0"
                                                      ToolTip="{loc:L TipAutoGraphPinned}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                        </StackPanel>
                                        <DockPanel Margin="0,10,0,5" ToolTip="{loc:L TipGraphMaxTime}">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" FlowDirection="LeftToRight"><TextBox x:Name="GraphMaxBox" FlowDirection="LeftToRight" Style="{StaticResource SettingNumberBox}" TextChanged="OnSettingChanged"/><TextBlock Text="s" Style="{StaticResource SettingUnitLabel}"/></StackPanel>
                                            <TextBlock Text="{loc:L GraphMaxTime}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Daten / Data -->
                                <StackPanel x:Name="DataPage" Visibility="Collapsed">
                                    <!-- Output -->
                                    <TextBlock Text="{loc:L TabOutput}" Foreground="{DynamicResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                                    <TextBlock Text="{loc:L OutputDir}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,0,4" ToolTip="{loc:L TipOutputDir}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{loc:L Browse}" Click="OnBrowse" ToolTip="{loc:L TipBrowseOutput}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                                        <TextBox x:Name="OutputDirBox" FontSize="13" ToolTip="{loc:L TipOutputDir}" TextChanged="OnOutputDirValidate" LostFocus="OnPathFieldCommit"/>
                                    </DockPanel>
                                    <TextBlock x:Name="OutputDirError" Foreground="{DynamicResource Red}" FontSize="11" Visibility="Collapsed" Margin="2,3,0,0"/>
                                    <!-- TXT/CSV toggle only in the sidebar pills now, to stop the two
                                         places from drifting out of sync - this is a pointer, not a control. -->
                                    <TextBlock Text="{loc:L TxtCsvInSidebarHint}" Foreground="{DynamicResource Subtext}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="HtmlReportBox" Content="{loc:L HtmlReportLabel}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,8,0,0" ToolTip="{loc:L TipHtmlReport}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>

                                    <!-- Database -->
                                    <TextBlock Text="{loc:L TabDatabase}" Foreground="{DynamicResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,22,0,8"/>
                                    <TextBlock Text="{loc:L ConfNote}" Foreground="{DynamicResource Subtext}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    <TextBlock Text="{loc:L DbPrivacyNote}" Foreground="{DynamicResource Subtext}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <TextBlock Text="{loc:L DbFile}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,0,4" ToolTip="{loc:L TipDbFile}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{loc:L Browse}" Click="OnBrowseDb" ToolTip="{loc:L TipBrowseDb}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                                        <TextBox x:Name="DbPathBox" FontSize="13" ToolTip="{loc:L TipDbFile}" TextChanged="OnDbPathValidate" LostFocus="OnPathFieldCommit"/>
                                    </DockPanel>
                                    <TextBlock x:Name="DbPathError" Foreground="{DynamicResource Red}" FontSize="11" Visibility="Collapsed" Margin="2,3,0,12"/>
                                    <DockPanel Margin="0,12,0,0">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                            <Button Content="{loc:L MergeDb}" Click="OnMergeDb" Style="{StaticResource GhostButton}" ToolTip="{loc:L TipMergeDb}"/>
                                            <Button Content="{loc:L ClearDb}" Click="OnClearDb" Style="{StaticResource DangerButton}" Margin="10,0,0,0" ToolTip="{loc:L TipClearDb}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="KnownDbBox" Content="{loc:L KnownDb}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" ToolTip="{loc:L TipKnownDb}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    </DockPanel>
                                    <CheckBox x:Name="ScanHistoryBox" Content="{loc:L ScanHistory}" Margin="0,10,0,0"
                                              Foreground="{DynamicResource Text}" FontSize="13" ToolTip="{loc:L TipScanHistory}"
                                              IsEnabled="{Binding IsChecked, ElementName=KnownDbBox}"
                                              Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    <!-- Plain-CSV escape hatch for the now-encrypted database -
                                         moving history to a different Windows account/machine. -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{loc:L ExportDbCsv}" Click="OnExportDbCsv" Style="{StaticResource GhostButton}" ToolTip="{loc:L TipExportDbCsv}"/>
                                        <Button Content="{loc:L ImportDbCsv}" Click="OnImportDbCsv" Style="{StaticResource GhostButton}" Margin="10,0,0,0" ToolTip="{loc:L TipImportDbCsv}"/>
                                    </StackPanel>
                                    <DockPanel Margin="0,12,0,0" ToolTip="{loc:L TipDbRetention}">
                                        <ComboBox x:Name="DbRetentionBox" DockPanel.Dock="Right" MinWidth="140" Height="32"
                                                  SelectionChanged="OnSettingChanged"/>
                                        <TextBlock Text="{loc:L DbRetentionLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0" ToolTip="{loc:L TipArchiveRetention}">
                                        <ComboBox x:Name="ArchiveRetentionBox" DockPanel.Dock="Right" MinWidth="140" Height="32"
                                                  SelectionChanged="OnSettingChanged"/>
                                        <TextBlock Text="{loc:L ArchiveRetentionLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0" ToolTip="{loc:L TipArchiveCompaction}">
                                        <ComboBox x:Name="ArchiveCompactionBox" DockPanel.Dock="Right" MinWidth="140" Height="32"
                                                  SelectionChanged="OnSettingChanged"/>
                                        <TextBlock Text="{loc:L ArchiveCompactionLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0" ToolTip="{loc:L TipArchiveBackupRetention}">
                                        <ComboBox x:Name="ArchiveBackupRetentionBox" DockPanel.Dock="Right" MinWidth="140" Height="32"
                                                  SelectionChanged="OnSettingChanged"/>
                                        <TextBlock Text="{loc:L ArchiveBackupRetentionLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                    </DockPanel>

                                    <!-- Configuration file -->
                                    <TextBlock Text="{loc:L TabConfig}" Foreground="{DynamicResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,22,0,8"/>
                                    <TextBlock Text="{loc:L ConfDirLabel}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,0,0,4" ToolTip="{loc:L TipConfDir}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{loc:L Browse}" Click="OnBrowseConfDir" ToolTip="{loc:L TipBrowseConf}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                                        <TextBox x:Name="ConfDirBox" FontSize="13" ToolTip="{loc:L TipConfDir}" TextChanged="OnConfDirChanged" LostFocus="OnPathFieldCommit"/>
                                    </DockPanel>
                                    <TextBlock x:Name="ConfDirError" Foreground="{DynamicResource Red}" FontSize="11" Visibility="Collapsed" Margin="2,3,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="{loc:L ExportConf}" Click="OnExportConf" Style="{StaticResource AccentButton}" ToolTip="{loc:L TipExportConf}"/>
                                        <Button Content="{loc:L ImportConf}" Click="OnImportConf" Style="{StaticResource GhostButton}" Margin="10,0,0,0" ToolTip="{loc:L TipImportConf}"/>
                                    </StackPanel>

                                    <!-- Full backup and restore -->
                                    <TextBlock Text="{loc:L BackupHeader}" Foreground="{DynamicResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,22,0,8"/>
                                    <TextBlock Text="{loc:L BackupHint}" Foreground="{DynamicResource Subtext}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Button Content="{loc:L BackupButton}" Click="OnBackupAll" Style="{StaticResource AccentButton}" Margin="0,0,10,6" ToolTip="{loc:L TipBackup}"/>
                                        <Button Content="{loc:L RestoreButton}" Click="OnRestoreAll" Style="{StaticResource GhostButton}" Margin="0,0,0,6" ToolTip="{loc:L TipRestore}"/>
                                    </WrapPanel>

                                    <!-- Listen aus Datei importieren -->
                                    <TextBlock Text="{loc:L ImportListsHeader}" Foreground="{DynamicResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,22,0,8"/>
                                    <TextBlock Text="{loc:L ImportListsHint}" Foreground="{DynamicResource Subtext}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                                            <TextBlock Text="{loc:L ImportListsTargetLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="ImportTargetBox" ToolTip="{loc:L TipImportTarget}" MinWidth="150" Height="32"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{loc:L ImportListsModeLabel}" Foreground="{DynamicResource Text}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="ImportModeBox" ToolTip="{loc:L TipImportMode}" MinWidth="120" Height="32"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="{loc:L ImportListsBrowse}" Click="OnImportListsBrowse" ToolTip="{loc:L TipImportBrowse}" Style="{StaticResource GhostButton}"/>
                                        <Button x:Name="ImportListsCommitBtn" ToolTip="{loc:L TipImportCommit}" Content="{loc:L ImportListsCommit}" Click="OnImportListsCommit" Style="{StaticResource AccentButton}" Margin="10,0,0,0" IsEnabled="False"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="ImportListsPreview" Foreground="{DynamicResource Subtext}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>

                                <!-- App -->
                                <StackPanel x:Name="AppPage" Visibility="Collapsed">
                                    <CheckBox x:Name="MinimizeTrayBox" Content="{loc:L MinimizeToTray}" Foreground="{DynamicResource Text}" FontSize="13"
                                              ToolTip="{loc:L TipMinimizeToTray}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    <CheckBox x:Name="CheckForUpdatesBox" Content="{loc:L CheckForUpdatesLabel}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,8,0,0"
                                              ToolTip="{loc:L TipCheckForUpdates}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBlock x:Name="UpdateStatusText" DockPanel.Dock="Right" Foreground="{DynamicResource Subtext}" FontSize="12" VerticalAlignment="Center"/>
                                        <Button Content="{loc:L CheckUpdatesNow}" Click="OnCheckUpdatesNow" ToolTip="{loc:L TipCheckUpdatesNow}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="14,6"/>
                                    </DockPanel>
                                </StackPanel>

                                <!-- Über / About -->
                                <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                                    <TextBlock Text="IP-Scanner" Foreground="{DynamicResource Mauve}" FontSize="18" FontWeight="Bold"/>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:L AboutVersionLabel}" Foreground="{DynamicResource Subtext}" FontSize="13" Margin="0,4,12,4"/>
                                        <TextBlock x:Name="AboutVersionText" Grid.Row="0" Grid.Column="1" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:L AboutManufacturerLabel}" Foreground="{DynamicResource Subtext}" FontSize="13" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="BGCoding" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:L AboutLicenseLabel}" Foreground="{DynamicResource Subtext}" FontSize="13" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="MIT" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4"/>
                                    </Grid>
                                    <TextBlock x:Name="AboutCopyrightText" Foreground="{DynamicResource Subtext}" FontSize="12" Margin="0,10,0,0"/>
                                    <TextBlock Text="{loc:L AboutIconAttribution}" Foreground="{DynamicResource Subtext}" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0"/>
                                    <Button Content="{loc:L AboutOpenWindow}" Click="OnOpenAboutWindow" Style="{StaticResource AccentButton}"
                                            HorizontalAlignment="Left" Padding="16,7" Margin="0,18,0,0" ToolTip="{loc:L TipAboutOpenWindow}"/>
                                </StackPanel>
                                <!-- Every keyboard shortcut, with its action, in one place. -->
                                <StackPanel x:Name="HelpPage" Visibility="Collapsed">
                                    <TextBlock Text="{loc:L HelpPageTitle}" Foreground="{DynamicResource Mauve}" FontSize="18" FontWeight="Bold"/>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:L HelpShortcutHeader}" Foreground="{DynamicResource Subtext}" FontSize="12" FontWeight="Bold" Margin="0,0,0,7"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:L HelpActionHeader}" Foreground="{DynamicResource Subtext}" FontSize="12" FontWeight="Bold" Margin="0,0,0,7"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="F5" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:L HelpF5}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:L ShortcutCtrlF}" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:L HelpCtrlF}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Esc" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{loc:L HelpEsc}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:L ShortcutCtrlComma}" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{loc:L HelpCtrlComma}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:L ShortcutCtrlT}" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{loc:L HelpCtrlT}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:L ShortcutCtrlB}" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{loc:L HelpCtrlB}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:L ShortcutCtrlE}" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{loc:L HelpCtrlE}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="{loc:L ShortcutCtrl1}" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{loc:L HelpCtrl1}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="9" Grid.Column="0" Text="{loc:L ShortcutCtrl2}" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{loc:L HelpCtrl2}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="10" Grid.Column="0" Text="{loc:L ShortcutCtrl3}" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="10" Grid.Column="1" Text="{loc:L HelpCtrl3}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="11" Grid.Column="0" Text="{loc:L ShortcutCtrlC}" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="11" Grid.Column="1" Text="{loc:L HelpCtrlC}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="12" Grid.Column="0" Text="{loc:L KeyDel}" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="12" Grid.Column="1" Text="{loc:L HelpDel}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="13" Grid.Column="0" Text="F1" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,4,12,4"/>
                                        <TextBlock Grid.Row="13" Grid.Column="1" Text="{loc:L HelpF1}" Foreground="{DynamicResource Text}" FontSize="13" Margin="0,4" TextWrapping="Wrap"/>
                                    </Grid>
                                    <StackPanel x:Name="DriverHelpPanel" Margin="0,26,0,0"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>
        <!-- The page fits the host width (no horizontal scroll, its action rows wrap); only the height may scroll. The opaque Background keeps the main window from showing through any gutter. -->
        <ScrollViewer x:Name="ArchiveScroll" Grid.Row="1" Visibility="Collapsed" IsVisibleChanged="OnOtherPageVisibleChanged"
                      Background="{DynamicResource Bg}"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <views:ArchivePage x:Name="ArchiveOverlay" MinHeight="450"
                               Height="{Binding ActualHeight, ElementName=ArchiveScroll}"/>
        </ScrollViewer>
        <ScrollViewer x:Name="LogScroll" Grid.Row="1" Visibility="Collapsed"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <views:LogPage x:Name="LogOverlay" MinWidth="700" MinHeight="450"
                           Width="{Binding ActualWidth, ElementName=LogScroll}"
                           Height="{Binding ActualHeight, ElementName=LogScroll}"/>
        </ScrollViewer>
    </Grid>
</Window>
