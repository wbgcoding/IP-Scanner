<Window x:Class="IpScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:IpScanner.Views.Controls"
        xmlns:loc="clr-namespace:IpScanner.Core.Localization"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="IP-Scanner" Height="720" Width="1320" MinWidth="700" MinHeight="480"
        Icon="Resources/network.ico" Background="{StaticResource Bg}"
        WindowStartupLocation="Manual">
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgDark}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title + logo -->
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="IP-Scanner" Foreground="{StaticResource Mauve}"
                               FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    <Image x:Name="LogoImage" Source="/Resources/logo.png" Width="42" Height="42"
                           Margin="0,5,0,0" HorizontalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </StackPanel>

                <!-- Center: progress bars -->
                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Loc.Devices}" Foreground="{StaticResource Subtext}" FontSize="11"
                                   HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ctrl:SegmentedProgressBar Grid.Column="1" Height="13"
                            Track="{StaticResource Surface}"
                            Color1="{StaticResource Green}" Color2="{StaticResource Red}" Color3="{StaticResource GrayBlock}"
                            Fraction1="{Binding Progress.OnlineFraction}"
                            Fraction2="{Binding Progress.OfflineFraction}"
                            Fraction3="{Binding Progress.UnknownFraction}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Progress.DeviceCountText}"
                                   Foreground="{StaticResource Text}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Geräte legend -->
                    <StackPanel Orientation="Horizontal" Margin="56,0,0,4">
                        <Border Background="{StaticResource Green}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Progress.OnlineText}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="4,0,10,0"/>
                        <Border Background="{StaticResource Red}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Progress.OfflineText}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="4,0,10,0"/>
                        <Border Background="{StaticResource GrayBlock}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Progress.UnknownText}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Loc.Pings}" Foreground="{StaticResource Subtext}" FontSize="11"
                                   HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ctrl:SegmentedProgressBar Grid.Column="1" Height="13"
                            Track="{StaticResource Surface}"
                            Color1="{StaticResource Blue}" Color2="{StaticResource Peach}" Color3="{StaticResource MidGray}"
                            Fraction1="{Binding Progress.SuccessFraction}"
                            Fraction2="{Binding Progress.FailedFraction}"
                            Fraction3="{Binding Progress.SkippedFraction}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Progress.PingCountText}"
                                   Foreground="{StaticResource Text}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Pings legend -->
                    <StackPanel Orientation="Horizontal" Margin="56,4,0,0">
                        <Border Background="{StaticResource Blue}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Progress.SuccessText}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="4,0,10,0"/>
                        <Border Background="{StaticResource Peach}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Progress.FailedText}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="4,0,10,0"/>
                        <Border Background="{StaticResource MidGray}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Progress.SkippedText}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: subnet input above the scan controls -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                        <TextBox x:Name="SubnetBox" Width="160" Height="30" Margin="0,0,6,0" VerticalAlignment="Center"
                                 Foreground="{StaticResource Text}" FontSize="12" VerticalContentAlignment="Center" Padding="8,0"
                                 KeyDown="OnSubnetKeyDown" ToolTip="{x:Static loc:Loc.SubnetTooltip}"/>
                        <ComboBox x:Name="CidrBox" Width="80" Height="30" SelectedIndex="0" IsEditable="True"
                                  VerticalAlignment="Center" ToolTip="{x:Static loc:Loc.MaskTooltip}">
                            <sys:String>/24</sys:String>
                            <sys:String>/16</sys:String>
                            <sys:String>/8</sys:String>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{x:Static loc:Loc.PingsLabel}" Foreground="{StaticResource Subtext}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="PingCountBox" Width="80" Margin="0,0,6,0" SelectedIndex="0">
                            <ComboBoxItem>10</ComboBoxItem><ComboBoxItem>100</ComboBoxItem>
                            <ComboBoxItem>1000</ComboBoxItem><ComboBoxItem>10000</ComboBoxItem>
                            <ComboBoxItem>100000</ComboBoxItem><ComboBoxItem>∞</ComboBoxItem>
                        </ComboBox>
                        <Button x:Name="ScanStopButton" Content="{x:Static loc:Loc.Scan}" Click="OnScanStopClick"
                                Style="{StaticResource AccentButton}" MinWidth="86"/>
                        <Button x:Name="SettingsButton" Click="OnSettingsClick" Style="{StaticResource IconButton}"
                                ToolTip="{x:Static loc:Loc.Settings}">
                            <Viewbox Width="16" Height="16">
                                <!-- Gear (cog) vector -->
                                <Path Fill="{StaticResource Text}" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main: table + sidebar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
            <DataGrid Grid.Row="0" ItemsSource="{Binding Devices}" AutoGenerateColumns="False"
                      IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
                      RowBackground="{StaticResource Bg}" AlternatingRowBackground="{StaticResource BgAlt}"
                      BorderThickness="0" EnableRowVirtualization="True"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{x:Static loc:Loc.IpAddress}" Width="Auto" MinWidth="132">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IpDisplay}" Foreground="{Binding IpColor}" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static loc:Loc.Status}" Width="Auto" MinWidth="84">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static loc:Loc.Group}" Width="Auto" MinWidth="64">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="14" Height="14" CornerRadius="2" HorizontalAlignment="Center"
                                        Background="{Binding GroupColor}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static loc:Loc.Hostname}" Binding="{Binding Hostname}" Width="Auto" MinWidth="110"/>
                    <DataGridTemplateColumn Header="{x:Static loc:Loc.Avg}" Width="Auto" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding AvgMark}" Foreground="{Binding AvgMarkColor}" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding AvgDisplay}" Foreground="{Binding AvgColor}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static loc:Loc.Min}" Width="Auto" MinWidth="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding MinMark}" Foreground="{Binding MinMarkColor}" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding MinDisplay}" Foreground="{Binding MinColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static loc:Loc.Max}" Width="Auto" MinWidth="72">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding MaxMark}" Foreground="{Binding MaxMarkColor}" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding MaxDisplay}" Foreground="{Binding MaxColor}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static loc:Loc.Last}" Width="Auto" MinWidth="84">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding LastMark}" Foreground="{Binding LastMarkColor}" FontSize="9" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                    <TextBlock Text="{Binding LastDisplay}" Foreground="{Binding LastColor}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static loc:Loc.Progress}" Binding="{Binding ProgressDisplay}" Width="Auto" MinWidth="84"
                                        ElementStyle="{StaticResource CenterCell}"/>
                    <DataGridTextColumn Header="{x:Static loc:Loc.Mac}" Binding="{Binding Mac}" Width="Auto" MinWidth="136"
                                        ElementStyle="{StaticResource CenterCell}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Totals row: column averages across all visible devices -->
            <Border Grid.Row="1" Background="{StaticResource BgDark}"
                    BorderBrush="{StaticResource Surface}" BorderThickness="0,1,0,0" Padding="10,6">
                <Grid>
                <TextBlock Text="{Binding ThreadsText}" Foreground="{StaticResource Subtext}"
                           FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{x:Static loc:Loc.TotalRow}" Foreground="{StaticResource Mauve}"
                               FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock Text="{x:Static loc:Loc.Avg}" Foreground="{StaticResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalAvg}" Foreground="{Binding TotalAvgColor}" FontWeight="SemiBold" FontSize="11" Margin="5,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static loc:Loc.Min}" Foreground="{StaticResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalMin}" Foreground="{Binding TotalMinColor}" FontWeight="SemiBold" FontSize="11" Margin="5,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static loc:Loc.Max}" Foreground="{StaticResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalMax}" Foreground="{Binding TotalMaxColor}" FontWeight="SemiBold" FontSize="11" Margin="5,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{x:Static loc:Loc.Last}" Foreground="{StaticResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalLast}" Foreground="{Binding TotalLastColor}" FontWeight="SemiBold" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                </Grid>
            </Border>
            </Grid>

            <!-- Sidebar -->
            <Border Grid.Column="1" Background="{StaticResource BgDark}" BorderBrush="{StaticResource Surface}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Networks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="13,12" BorderBrush="{StaticResource Surface}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                                <Border Background="{Binding BadgeColor}" CornerRadius="8" Padding="7,2">
                                                    <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Bold" Foreground="#1E1E2E"/>
                                                </Border>
                                                <TextBlock Text="{Binding Cidr}" Foreground="{StaticResource Blue}"
                                                           FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <!-- Rows collapse when the value wasn't detected (extra subnets). -->
                                                <Grid Height="20" Visibility="{Binding HasIp, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{x:Static loc:Loc.OwnIp}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                    <TextBlock Text="{Binding Ip}" Foreground="{StaticResource Text}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Height="20" Visibility="{Binding HasGateway, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{x:Static loc:Loc.Gateway}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                    <TextBlock Text="{Binding Gateway}" Foreground="{StaticResource Green}" FontSize="11" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Height="20" Visibility="{Binding HasMask, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{x:Static loc:Loc.Mask}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                    <TextBlock Text="{Binding SubnetMask}" Foreground="{StaticResource Text}" FontSize="11" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Visibility="{Binding HasDns, Converter={StaticResource BoolToVis}}" MinHeight="20">
                                                    <TextBlock Text="{x:Static loc:Loc.Dns}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                    <TextBlock Text="{Binding Dns}" Foreground="{StaticResource Text}" FontSize="11" HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="170"/>
                                                </Grid>
                                                <Grid Height="20" Visibility="{Binding HasMac, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{x:Static loc:Loc.Mac}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                    <TextBlock Text="{Binding Mac}" Foreground="{StaticResource MidGray}" FontSize="11" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Height="20" Visibility="{Binding HasInterface, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{x:Static loc:Loc.Interface}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                    <TextBlock Text="{Binding Interface}" Foreground="{StaticResource Text}" FontSize="11" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border Height="8"/>
                                                <Grid Height="20">
                                                    <TextBlock Text="{x:Static loc:Loc.Online}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                    <TextBlock Text="{Binding OnlineCount}" Foreground="{StaticResource Green}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Height="20">
                                                    <TextBlock Text="{x:Static loc:Loc.Offline}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                    <TextBlock Text="{Binding OfflineCount}" Foreground="{StaticResource Subtext}" FontSize="11" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Height="20">
                                                    <TextBlock Text="{x:Static loc:Loc.AvgLatency}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                    <TextBlock Text="{Binding AvgLatency}" Foreground="{Binding AvgLatencyColor}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Internet latency -->
                        <Border Padding="13,12" BorderBrush="{StaticResource Surface}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Loc.InternetLatency}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="0,0,0,7"/>
                                <ItemsControl ItemsSource="{Binding InternetHosts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Subtext}" FontSize="11" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="Ø" Foreground="{StaticResource MidGray}" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding AvgDisplay}" Foreground="{Binding AvgColor}" FontSize="10" FontWeight="SemiBold" Margin="3,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Min" Foreground="{StaticResource MidGray}" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding MinDisplay}" Foreground="{Binding MinColor}" FontSize="10" Margin="3,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Max" Foreground="{StaticResource MidGray}" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding MaxDisplay}" Foreground="{Binding MaxColor}" FontSize="10" Margin="3,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Export -->
                        <Border Padding="13,12">
                            <StackPanel>
                                <StackPanel Visibility="{Binding HasExport, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{x:Static loc:Loc.LastExport}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding LastExportPath}" Foreground="{StaticResource MidGray}"
                                               FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ══ Embedded settings overlay (single page) ══ -->
        <Grid x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
              Background="#CC101018" MouseLeftButtonDown="OnOverlayBackgroundClick">
            <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Surface}" BorderThickness="1"
                    CornerRadius="10" Margin="40" MaxWidth="840">
                <DockPanel Margin="22">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="{x:Static loc:Loc.Settings}" Foreground="{StaticResource Mauve}" FontSize="20" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{x:Static loc:Loc.ResetDefaults}" Click="OnResetDefaults" Style="{StaticResource GhostButton}" Padding="14,7" ToolTip="{x:Static loc:Loc.TipResetDefaults}"/>
                            <Button Content="{x:Static loc:Loc.Save}" Click="OnSettingsSave" Style="{StaticResource AccentButton}" Padding="18,7" Margin="8,0,0,0"/>
                            <Button Content="{x:Static loc:Loc.Cancel}" Click="OnSettingsCancel" Style="{StaticResource GhostButton}" Padding="18,7" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Netzwerk -->
                            <TextBlock Text="{x:Static loc:Loc.TabNetwork}" Foreground="{StaticResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                            <TextBlock Text="{x:Static loc:Loc.Subnets}" Foreground="{StaticResource Text}" FontSize="13" Margin="0,0,0,4" ToolTip="{x:Static loc:Loc.TipSubnets}"/>
                            <Grid>
                                <TextBox x:Name="SubnetsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="120" FontSize="13"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" ToolTip="{x:Static loc:Loc.TipSubnets}"
                                         TextChanged="OnSubnetsValidate"/>
                                <TextBlock Text="192.168.2.0/24" Foreground="{StaticResource MidGray}" FontSize="13" IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SubnetsBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <TextBlock x:Name="SubnetsError" Foreground="{StaticResource Red}" FontSize="11" Visibility="Collapsed" Margin="2,3,0,0"/>
                            <TextBlock Text="{x:Static loc:Loc.PinnedIps}" Foreground="{StaticResource Text}" FontSize="13" Margin="0,14,0,4" ToolTip="{x:Static loc:Loc.TipPinnedIps}"/>
                            <Grid>
                                <TextBox x:Name="PinnedBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="100" FontSize="13"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" ToolTip="{x:Static loc:Loc.TipPinnedIps}"
                                         TextChanged="OnPinnedValidate"/>
                                <TextBlock Text="192.168.2.10, 192.168.2.20" Foreground="{StaticResource MidGray}" FontSize="13" IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PinnedBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock x:Name="PinnedError" Foreground="{StaticResource Red}" FontSize="11" Visibility="Collapsed" Margin="2,3,0,0"/>

                            <!-- Ping -->
                            <TextBlock Text="{x:Static loc:Loc.TabPing}" Foreground="{StaticResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,22,0,8"/>
                            <!-- Two columns to save height; inputs right, labels left. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- Right-aligned numbers with a fixed (read-only) unit suffix. -->
                                <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,5" ToolTip="{x:Static loc:Loc.TipScanThreads}">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBox x:Name="ScanThreadsBox" Width="70" FontSize="13" TextAlignment="Right"/><TextBlock Width="26" FontSize="12" Foreground="{StaticResource Subtext}" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                                    <TextBlock Text="{x:Static loc:Loc.ScanThreads}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,5" ToolTip="{x:Static loc:Loc.TipPingInterval}">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBox x:Name="IntervalBox" Width="70" FontSize="13" TextAlignment="Right"/><TextBlock Text="ms" Width="26" FontSize="12" Foreground="{StaticResource Subtext}" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                                    <TextBlock Text="{x:Static loc:Loc.PingInterval}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Grid.Row="2" Grid.Column="0" Margin="0,5" ToolTip="{x:Static loc:Loc.TipOfflineAfter}">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBox x:Name="OfflineAfterBox" Width="70" FontSize="13" TextAlignment="Right"/><TextBlock Width="26" FontSize="12" Foreground="{StaticResource Subtext}" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                                    <TextBlock Text="{x:Static loc:Loc.OfflineAfter}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Grid.Row="3" Grid.Column="0" Margin="0,5" ToolTip="{x:Static loc:Loc.TipTextScale}">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBox x:Name="UiScaleBox" Width="70" FontSize="13" TextAlignment="Right"/><TextBlock Text="%" Width="26" FontSize="12" Foreground="{StaticResource Subtext}" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                                    <TextBlock Text="{x:Static loc:Loc.TextScale}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,5" ToolTip="{x:Static loc:Loc.TipInitPings}">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBox x:Name="InitPingCountBox" Width="70" FontSize="13" TextAlignment="Right"/><TextBlock Width="26" FontSize="12" Foreground="{StaticResource Subtext}" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                                    <TextBlock Text="{x:Static loc:Loc.InitPings}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Grid.Row="1" Grid.Column="2" Margin="0,5" ToolTip="{x:Static loc:Loc.TipStartupPings}">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBox x:Name="StartupPingsBox" Width="70" FontSize="13" TextAlignment="Right"/><TextBlock Width="26" FontSize="12" Foreground="{StaticResource Subtext}" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                                    <TextBlock Text="{x:Static loc:Loc.StartupPings}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Grid.Row="2" Grid.Column="2" Margin="0,5" ToolTip="{x:Static loc:Loc.TipOfflineRecheck}">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><TextBox x:Name="OfflineRecheckBox" Width="70" FontSize="13" TextAlignment="Right"/><TextBlock Text="s" Width="26" FontSize="12" Foreground="{StaticResource Subtext}" VerticalAlignment="Center" Margin="6,0,0,0"/></StackPanel>
                                    <TextBlock Text="{x:Static loc:Loc.OfflineRecheck}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Grid>

                            <!-- Internet -->
                            <TextBlock Text="{x:Static loc:Loc.TabInternet}" Foreground="{StaticResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,22,0,8"/>
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" ToolTip="{x:Static loc:Loc.TipInternetTimeout}">
                                    <TextBlock Text="{x:Static loc:Loc.InternetTimeout}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="InternetTimeoutBox" Width="70" FontSize="13" TextAlignment="Right"/>
                                    <TextBlock Text="ms" FontSize="12" Foreground="{StaticResource Subtext}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="EnableInternetBox" Content="{x:Static loc:Loc.EnableInternet}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center" ToolTip="{x:Static loc:Loc.TipEnableInternet}"/>
                            </DockPanel>
                            <TextBlock Text="{x:Static loc:Loc.InternetHosts}" Foreground="{StaticResource Text}" FontSize="13" Margin="0,12,0,4" ToolTip="{x:Static loc:Loc.TipInternetHosts}"/>
                            <Grid>
                                <TextBox x:Name="InternetHostsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="100" FontSize="13"
                                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" ToolTip="{x:Static loc:Loc.TipInternetHosts}"/>
                                <TextBlock Text="8.8.8.8 Google, 1.1.1.1 Cloudflare" Foreground="{StaticResource MidGray}" FontSize="13" IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=InternetHostsBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- Ausgabe -->
                            <TextBlock Text="{x:Static loc:Loc.TabOutput}" Foreground="{StaticResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,22,0,8"/>
                            <TextBlock Text="{x:Static loc:Loc.OutputDir}" Foreground="{StaticResource Text}" FontSize="13" Margin="0,0,0,4" ToolTip="{x:Static loc:Loc.TipOutputDir}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{x:Static loc:Loc.Browse}" Click="OnBrowse" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                                <TextBox x:Name="OutputDirBox" FontSize="13" ToolTip="{x:Static loc:Loc.TipOutputDir}"/>
                            </DockPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <CheckBox x:Name="FileOutputBox" Content="{x:Static loc:Loc.WriteTxt}" Foreground="{StaticResource Text}" FontSize="13" ToolTip="{x:Static loc:Loc.TipWriteTxt}"/>
                                <CheckBox x:Name="ExportCsvBox" Content="{x:Static loc:Loc.ExportCsv}" Foreground="{StaticResource Text}" FontSize="13" Margin="24,0,0,0" ToolTip="{x:Static loc:Loc.TipExportCsv}"/>
                            </StackPanel>

                            <!-- Datenbank -->
                            <TextBlock Text="{x:Static loc:Loc.TabDatabase}" Foreground="{StaticResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,22,0,8"/>
                            <TextBlock Text="{x:Static loc:Loc.ConfNote}" Foreground="{StaticResource Subtext}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="{x:Static loc:Loc.DbFile}" Foreground="{StaticResource Text}" FontSize="13" Margin="0,0,0,4" ToolTip="{x:Static loc:Loc.TipDbFile}"/>
                            <DockPanel Margin="0,0,0,12">
                                <Button DockPanel.Dock="Right" Content="{x:Static loc:Loc.Browse}" Click="OnBrowseDb" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
                                <TextBox x:Name="DbPathBox" FontSize="13" ToolTip="{x:Static loc:Loc.TipDbFile}"/>
                            </DockPanel>
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="{x:Static loc:Loc.MergeDb}" Click="OnMergeDb" Style="{StaticResource GhostButton}" ToolTip="{x:Static loc:Loc.TipMergeDb}"/>
                                    <Button Content="{x:Static loc:Loc.ClearDb}" Click="OnClearDb" Style="{StaticResource DangerButton}" Margin="10,0,0,0" ToolTip="{x:Static loc:Loc.TipClearDb}"/>
                                </StackPanel>
                                <CheckBox x:Name="KnownDbBox" Content="{x:Static loc:Loc.KnownDb}" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center" ToolTip="{x:Static loc:Loc.TipKnownDb}"/>
                            </DockPanel>

                            <!-- Konfigurationsdatei -->
                            <TextBlock Text="{x:Static loc:Loc.TabConfig}" Foreground="{StaticResource Blue}" FontWeight="Bold" FontSize="15" Margin="0,22,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{x:Static loc:Loc.ExportConf}" Click="OnExportConf" Style="{StaticResource AccentButton}" ToolTip="{x:Static loc:Loc.TipExportConf}"/>
                                <Button Content="{x:Static loc:Loc.ImportConf}" Click="OnImportConf" Style="{StaticResource GhostButton}" Margin="10,0,0,0" ToolTip="{x:Static loc:Loc.TipImportConf}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
