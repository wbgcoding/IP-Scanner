<Window x:Class="IpScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:IpScanner.Views.Controls"
        xmlns:loc="clr-namespace:IpScanner.Core.Localization"
        Title="IP-Scanner" Height="720" Width="1320" MinWidth="700" MinHeight="480"
        Icon="Resources/network.ico" Background="{StaticResource Bg}"
        WindowStartupLocation="Manual">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgDark}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title + subnet pills -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="IP-Scanner" Foreground="{StaticResource Mauve}"
                               FontWeight="Bold" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="SubnetBox" Width="160" Height="30" Margin="0,0,6,0" VerticalAlignment="Center"
                             Foreground="{StaticResource Text}" FontSize="12" VerticalContentAlignment="Center" Padding="8,0"
                             KeyDown="OnSubnetKeyDown" ToolTip="{x:Static loc:Loc.SubnetTooltip}"/>
                    <ComboBox x:Name="CidrBox" Width="80" Height="30" SelectedIndex="0"
                              VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{x:Static loc:Loc.MaskTooltip}">
                        <ComboBoxItem>/24</ComboBoxItem>
                        <ComboBoxItem>/16</ComboBoxItem>
                        <ComboBoxItem>/8</ComboBoxItem>
                    </ComboBox>
                </StackPanel>

                <!-- Center: progress bars -->
                <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Loc.Devices}" Foreground="{StaticResource Subtext}" FontSize="11"
                                   HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ctrl:SegmentedProgressBar Grid.Column="1" Height="13"
                            Track="{StaticResource Surface}"
                            Color1="{StaticResource Green}" Color2="{StaticResource Red}" Color3="{StaticResource GrayBlock}"
                            Fraction1="{Binding Progress.OnlineFraction}"
                            Fraction2="{Binding Progress.OfflineFraction}"
                            Fraction3="{Binding Progress.UnknownFraction}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Progress.DeviceCountText}"
                                   Foreground="{StaticResource Text}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Geräte legend -->
                    <StackPanel Orientation="Horizontal" Margin="56,0,0,4">
                        <Border Background="{StaticResource Green}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Progress.OnlineText}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="4,0,10,0"/>
                        <Border Background="{StaticResource Red}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Progress.OfflineText}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="4,0,10,0"/>
                        <Border Background="{StaticResource GrayBlock}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Progress.UnknownText}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static loc:Loc.Pings}" Foreground="{StaticResource Subtext}" FontSize="11"
                                   HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <ctrl:SegmentedProgressBar Grid.Column="1" Height="13"
                            Track="{StaticResource Surface}"
                            Color1="{StaticResource Blue}" Color2="{StaticResource Peach}" Color3="{StaticResource MidGray}"
                            Fraction1="{Binding Progress.SuccessFraction}"
                            Fraction2="{Binding Progress.FailedFraction}"
                            Fraction3="{Binding Progress.SkippedFraction}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Progress.PingCountText}"
                                   Foreground="{StaticResource Text}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Pings legend -->
                    <StackPanel Orientation="Horizontal" Margin="56,4,0,0">
                        <Border Background="{StaticResource Blue}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Progress.SuccessText}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="4,0,10,0"/>
                        <Border Background="{StaticResource Peach}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Progress.FailedText}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="4,0,10,0"/>
                        <Border Background="{StaticResource MidGray}" Width="9" Height="9" CornerRadius="1" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Progress.SkippedText}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static loc:Loc.PingsLabel}" Foreground="{StaticResource Subtext}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="PingCountBox" Width="80" Margin="0,0,6,0" SelectedIndex="0">
                        <ComboBoxItem>10</ComboBoxItem><ComboBoxItem>100</ComboBoxItem>
                        <ComboBoxItem>1000</ComboBoxItem><ComboBoxItem>10000</ComboBoxItem>
                        <ComboBoxItem>100000</ComboBoxItem><ComboBoxItem>∞</ComboBoxItem>
                    </ComboBox>
                    <Button x:Name="ScanButton" Content="{x:Static loc:Loc.Scan}" Click="OnScanClick" Style="{StaticResource AccentButton}"/>
                    <Button x:Name="StopButton" Content="{x:Static loc:Loc.Stop}" Click="OnStopClick" Style="{StaticResource DangerButton}"/>
                    <Button x:Name="SettingsButton" Content="⚙" Click="OnSettingsClick" Style="{StaticResource GhostButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main: table + sidebar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Devices}" AutoGenerateColumns="False"
                      IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
                      RowBackground="{StaticResource Bg}" AlternatingRowBackground="{StaticResource BgAlt}"
                      BorderThickness="0" EnableRowVirtualization="True"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{x:Static loc:Loc.IpAddress}" Width="Auto" MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IpDisplay}" Foreground="{Binding IpColor}" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static loc:Loc.Status}" Width="Auto" MinWidth="74">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource Green}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static loc:Loc.Group}" Width="Auto" MinWidth="56">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="14" Height="14" CornerRadius="2" HorizontalAlignment="Center"
                                        Background="{Binding GroupColor}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static loc:Loc.Hostname}" Binding="{Binding Hostname}" Width="Auto" MinWidth="90"/>
                    <DataGridTemplateColumn Header="{x:Static loc:Loc.Avg}" Width="Auto" MinWidth="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AvgDisplay}" Foreground="{Binding AvgColor}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static loc:Loc.Min}" Width="Auto" MinWidth="48">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MinDisplay}" Foreground="{Binding MinColor}"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static loc:Loc.Max}" Width="Auto" MinWidth="48">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MaxDisplay}" Foreground="{Binding MaxColor}"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static loc:Loc.Last}" Width="Auto" MinWidth="55">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastDisplay}" Foreground="{Binding LastColor}"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{x:Static loc:Loc.Progress}" Binding="{Binding ProgressDisplay}" Width="Auto" MinWidth="70"
                                        ElementStyle="{StaticResource CenterCell}"/>
                    <DataGridTextColumn Header="{x:Static loc:Loc.Mac}" Binding="{Binding Mac}" Width="Auto" MinWidth="120"
                                        ElementStyle="{StaticResource CenterCell}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Sidebar -->
            <Border Grid.Column="1" Background="{StaticResource BgDark}" BorderBrush="{StaticResource Surface}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Networks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="13,12" BorderBrush="{StaticResource Surface}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                                                <Border Background="{Binding BadgeColor}" CornerRadius="8" Padding="7,2">
                                                    <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Bold" Foreground="#1E1E2E"/>
                                                </Border>
                                                <TextBlock Text="{Binding Cidr}" Foreground="{StaticResource Blue}"
                                                           FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="20"/><RowDefinition Height="20"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="20"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="20"/><RowDefinition Height="20"/><RowDefinition Height="20"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{x:Static loc:Loc.OwnIp}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Ip}" Foreground="{StaticResource Text}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Row="1" Text="{x:Static loc:Loc.Gateway}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Gateway}" Foreground="{StaticResource Green}" FontSize="11" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Row="2" Text="{x:Static loc:Loc.Mask}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SubnetMask}" Foreground="{StaticResource Text}" FontSize="11" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Row="3" Text="{x:Static loc:Loc.Dns}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Dns}" Foreground="{StaticResource Text}" FontSize="11" HorizontalAlignment="Right" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Row="4" Text="{x:Static loc:Loc.Mac}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Mac}" Foreground="{StaticResource MidGray}" FontSize="11" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Row="5" Text="{x:Static loc:Loc.Interface}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Interface}" Foreground="{StaticResource Text}" FontSize="11" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Row="7" Text="{x:Static loc:Loc.Online}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding OnlineCount}" Foreground="{StaticResource Green}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Row="8" Text="{x:Static loc:Loc.Offline}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding OfflineCount}" Foreground="{StaticResource Subtext}" FontSize="11" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Row="9" Text="{x:Static loc:Loc.AvgLatency}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding AvgLatency}" Foreground="{StaticResource Text}" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Internet latency -->
                        <Border Padding="13,12" BorderBrush="{StaticResource Surface}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:Loc.InternetLatency}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="0,0,0,7"/>
                                <ItemsControl ItemsSource="{Binding InternetHosts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Subtext}" FontSize="11"/>
                                                <TextBlock Text="{Binding LatencyDisplay}" Foreground="{StaticResource Green}"
                                                           FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Phase + export -->
                        <Border Padding="13,12">
                            <StackPanel>
                                <Border Background="{StaticResource BgAlt}" CornerRadius="5" Padding="9,7" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Progress.Phase}" Foreground="{StaticResource Mauve}"
                                               FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel Visibility="{Binding HasExport, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{x:Static loc:Loc.LastExport}" Foreground="{StaticResource Subtext}" FontSize="10" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding LastExportPath}" Foreground="{StaticResource MidGray}"
                                               FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
