<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ══ Catppuccin Latte (light) - same keys as the dark theme ══ -->
    <SolidColorBrush x:Key="Bg"        Color="#EFF1F5"/>
    <SolidColorBrush x:Key="BgAlt"     Color="#E6E9EF"/>
    <SolidColorBrush x:Key="BgDark"    Color="#DCE0E8"/>
    <SolidColorBrush x:Key="Surface"   Color="#CCD0DA"/>
    <SolidColorBrush x:Key="Surface2"  Color="#BCC0CC"/>
    <SolidColorBrush x:Key="Text"      Color="#4C4F69"/>
    <SolidColorBrush x:Key="Subtext"   Color="#8C8FA1"/>
    <SolidColorBrush x:Key="Green"     Color="#40A02B"/>
    <SolidColorBrush x:Key="Lime"      Color="#7A9A01"/>
    <SolidColorBrush x:Key="Red"       Color="#D20F39"/>
    <SolidColorBrush x:Key="Blue"      Color="#1E66F5"/>
    <SolidColorBrush x:Key="Mauve"     Color="#8839EF"/>
    <SolidColorBrush x:Key="Peach"     Color="#FE640B"/>
    <SolidColorBrush x:Key="Yellow"    Color="#A8690B"/>
    <SolidColorBrush x:Key="Teal"      Color="#0F7C83"/>
    <SolidColorBrush x:Key="GrayBlock" Color="#BCC0CC"/>
    <SolidColorBrush x:Key="MidGray"   Color="#9CA0B0"/>
    <!-- Unknown-device row highlight and the dimmer behind the Settings overlay. -->
    <SolidColorBrush x:Key="RogueBg"    Color="#FDEBD3"/>
    <SolidColorBrush x:Key="OverlayDim" Color="#CC101018"/>
    <!-- Text/icon color drawn on top of the Green/Red accent surfaces.
         Green (#40A02B) still passes AA with dark text (5.87:1); Red (#D20F39)
         does not (3.61:1) so its "on" color switches to white here (5.43:1). -->
    <SolidColorBrush x:Key="OnAccentText" Color="#0B0B12"/>
    <SolidColorBrush x:Key="OnDangerText" Color="#FFFFFF"/>
</ResourceDictionary>
