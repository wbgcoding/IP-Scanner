<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ══ Catppuccin Mocha (dark) ══ -->
    <SolidColorBrush x:Key="Bg"        Color="#1E1E2E"/>
    <SolidColorBrush x:Key="BgAlt"     Color="#252535"/>
    <SolidColorBrush x:Key="BgDark"    Color="#181825"/>
    <SolidColorBrush x:Key="Surface"   Color="#313244"/>
    <SolidColorBrush x:Key="Surface2"  Color="#45475A"/>
    <SolidColorBrush x:Key="Text"      Color="#CDD6F4"/>
    <SolidColorBrush x:Key="Subtext"   Color="#6C7086"/>
    <SolidColorBrush x:Key="Green"     Color="#A6E3A1"/>
    <SolidColorBrush x:Key="Lime"      Color="#D2E59E"/>
    <SolidColorBrush x:Key="Red"       Color="#F38BA8"/>
    <SolidColorBrush x:Key="Blue"      Color="#89B4FA"/>
    <SolidColorBrush x:Key="Mauve"     Color="#CBA6F7"/>
    <SolidColorBrush x:Key="Peach"     Color="#FAB387"/>
    <SolidColorBrush x:Key="Yellow"    Color="#F9E2AF"/>
    <SolidColorBrush x:Key="Teal"      Color="#94E2D5"/>
    <SolidColorBrush x:Key="GrayBlock" Color="#45475A"/>
    <SolidColorBrush x:Key="MidGray"   Color="#585B70"/>
    <!-- Unknown-device row highlight and the dimmer behind the Settings overlay. -->
    <SolidColorBrush x:Key="RogueBg"    Color="#3A2E1A"/>
    <SolidColorBrush x:Key="OverlayDim" Color="#CC101018"/>
    <!-- Text/icon color drawn on top of the Green/Red accent surfaces
         (buttons, checked pill, checked checkbox) - was hardcoded, so it never
         adapted per theme and one spot failed AA contrast in light mode. -->
    <SolidColorBrush x:Key="OnAccentText" Color="#0B0B12"/>
    <SolidColorBrush x:Key="OnDangerText" Color="#0B0B12"/>
</ResourceDictionary>
