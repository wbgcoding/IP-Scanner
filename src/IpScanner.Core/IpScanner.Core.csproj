<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IpScanner</RootNamespace>
    <AssemblyName>IpScanner.Core</AssemblyName>
    <Company>BGCoding</Company>
    <Product>IP-Scanner</Product>
    <Copyright>© 2026 BGCoding</Copyright>
    <!-- The product ships for Windows only (DPAPI, ACLs, registry); the library stays plain net8.0
         so it carries no WPF or WinForms. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <!-- ZIP with AES-256 (WinZip AE-2) for password-protected backups; MIT licensed. -->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <!-- DPAPI wrapper for the per-installation device-data key: managed-only, safe for
         single-file publish (no native SQLCipher bundle, no password prompt). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IpScanner.Tests" />
    <InternalsVisibleTo Include="IP-Scanner" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\oui.txt" />
    <EmbeddedResource Include="Resources\port-frequency.txt" />
    <EmbeddedResource Include="Resources\scan-report.xsd" />
    <EmbeddedResource Include="Resources\service-probes.json" />
    <EmbeddedResource Include="Resources\lang\*.json" />
  </ItemGroup>
</Project>